<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Quản lý mua hàng</title>

    <!-- Bootstrap -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <!-- CSS chung -->
    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/QLMuaHangVaNCC_UNETI06_TI17A1HN.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- ================= HEADER ================= -->
    <header>
        <nav class="navbar navbar-expand-lg main-navbar">
            <div class="container-fluid px-4">

                <!-- LOGO -->
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-cart-check-fill me-1"></i>
                    QL Mua Hàng
                </a>

                <!-- Nút menu mobile -->
                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar"
                        aria-controls="mainNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">

                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="mainNavbar">

                    <!-- MENU TRÁI -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">

                        <!-- Trang chủ -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door me-1"></i>
                                Trang chủ
                            </a>
                        </li>

                        <!-- Danh mục -->
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-grid me-1"></i>
                                Danh mục
                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="HangHoa"
                                       asp-action="Index">

                                        <i class="bi bi-box-seam me-2"></i>
                                        Hàng hóa
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="LoaiHang"
                                       asp-action="Index">

                                        <i class="bi bi-tags me-2"></i>
                                        Loại hàng
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="DonViTinh"
                                       asp-action="Index">

                                        <i class="bi bi-rulers me-2"></i>
                                        Đơn vị tính
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="BoPhanDeNghi"
                                       asp-action="Index">

                                        <i class="bi bi-building me-2"></i>
                                        Bộ phận đề nghị
                                    </a>
                                </li>

                            </ul>
                        </li>

                        <!-- Nhà cung cấp -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="NhaCungCap"
                               asp-action="Index">

                                <i class="bi bi-truck me-1"></i>
                                Nhà cung cấp
                            </a>
                        </li>

                        <!-- Mua hàng -->
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-cart me-1"></i>
                                Mua hàng
                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="YeuCauMuaHang"
                                       asp-action="Index">

                                        <i class="bi bi-file-earmark-text me-2"></i>
                                        Yêu cầu mua hàng
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="DonMuaHang"
                                       asp-action="Index">

                                        <i class="bi bi-receipt me-2"></i>
                                        Đơn mua hàng
                                    </a>
                                </li>

                            </ul>
                        </li>

                        <!-- Giao hàng -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="LanGiaoHang"
                               asp-action="Index">

                                <i class="bi bi-box-arrow-in-down me-1"></i>
                                Giao hàng
                            </a>
                        </li>

                        <!-- Thanh toán -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="ThanhToanDonMua"
                               asp-action="Index">

                                <i class="bi bi-cash-coin me-1"></i>
                                Thanh toán
                            </a>
                        </li>

                    </ul>

                    <!-- USER -->
                    <ul class="navbar-nav">

                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle user-box"
                               href="#"
                               role="button"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-person-circle user-icon"></i>
                                Tài khoản
                            </a>

                            <ul class="dropdown-menu dropdown-menu-end">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="TaiKhoan"
                                       asp-action="Index">

                                        <i class="bi bi-person me-2"></i>
                                        Quản lý tài khoản
                                    </a>
                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>
                                    <a class="dropdown-item text-danger"
                                       href="#">

                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Đăng xuất
                                    </a>
                                </li>

                            </ul>

                        </li>

                    </ul>

                </div>
            </div>
        </nav>
    </header>


    <!-- ================= CONTENT ================= -->
    <div class="container-fluid px-4 main-content">

        <main role="main">
            @RenderBody()
        </main>

    </div>


    <!-- ================= FOOTER ================= -->
    <footer class="main-footer">

        <div class="container-fluid px-4 d-flex justify-content-between">

            <span>
                &copy; 2026 - Hệ thống Quản lý Mua hàng
            </span>

            <span>
                QLMuaHangVaNCC
            </span>

        </div>

    </footer>


    <!-- ================= JAVASCRIPT ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/layout.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>