<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Quản lý mua hàng</title>

    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/layout.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/QLMuaHangVaNCC_UNETI06_TI17A1HN.styles.css"
          asp-append-version="true" />
</head>

<body>

    <!-- ================= NAVBAR ================= -->
    <header>
        <nav class="navbar navbar-expand-xl main-navbar">
            <div class="container-fluid px-4">

                <!-- LOGO -->
                <a class="navbar-brand"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-cart-check-fill me-2"></i>
                    QL Mua Hàng
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#mainNavbar">

                    <span class="navbar-toggler-icon"></span>
                </button>


                <div class="collapse navbar-collapse"
                     id="mainNavbar">

                    <ul class="navbar-nav me-auto">

                        <!-- TRANG CHỦ -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house-door me-1"></i>
                                Trang chủ
                            </a>
                        </li>


                        <!-- ================= DANH MỤC ================= -->
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-grid me-1"></i>
                                Danh mục
                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="HangHoas"
                                       asp-action="Index">

                                        <i class="bi bi-box-seam me-2"></i>
                                        Hàng hóa
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="LoaiHangs"
                                       asp-action="Index">

                                        <i class="bi bi-tags me-2"></i>
                                        Loại hàng
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="DonViTinhs"
                                       asp-action="Index">

                                        <i class="bi bi-rulers me-2"></i>
                                        Đơn vị tính
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="BoPhanDeNghis"
                                       asp-action="Index">

                                        <i class="bi bi-building me-2"></i>
                                        Bộ phận đề nghị
                                    </a>
                                </li>

                            </ul>
                        </li>


                        <!-- ================= NHÀ CUNG CẤP ================= -->
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-truck me-1"></i>
                                Nhà cung cấp
                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="NhaCungCaps"
                                       asp-action="Index">

                                        <i class="bi bi-buildings me-2"></i>
                                        Danh sách nhà cung cấp
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="NhaCungCapHangHoas"
                                       asp-action="Index">

                                        <i class="bi bi-boxes me-2"></i>
                                        Hàng hóa nhà cung cấp
                                    </a>
                                </li>

                            </ul>
                        </li>


                        <!-- ================= MUA HÀNG ================= -->
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-cart me-1"></i>
                                Mua hàng
                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="YeuCauMuaHangs"
                                       asp-action="Index">

                                        <i class="bi bi-file-earmark-text me-2"></i>
                                        Yêu cầu mua hàng
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="ChiTietYeuCaus"
                                       asp-action="Index">

                                        <i class="bi bi-card-list me-2"></i>
                                        Chi tiết yêu cầu
                                    </a>
                                </li>

                                <li>
                                    <hr class="dropdown-divider" />
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="DonMuaHangs"
                                       asp-action="Index">

                                        <i class="bi bi-receipt me-2"></i>
                                        Đơn mua hàng
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="ChiTietDonMuas"
                                       asp-action="Index">

                                        <i class="bi bi-list-check me-2"></i>
                                        Chi tiết đơn mua
                                    </a>
                                </li>

                            </ul>
                        </li>


                        <!-- ================= GIAO HÀNG ================= -->
                        <li class="nav-item dropdown">

                            <a class="nav-link dropdown-toggle"
                               href="#"
                               data-bs-toggle="dropdown">

                                <i class="bi bi-box-arrow-in-down me-1"></i>
                                Giao hàng
                            </a>

                            <ul class="dropdown-menu">

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="LanGiaoHangs"
                                       asp-action="Index">

                                        <i class="bi bi-truck me-2"></i>
                                        Lần giao hàng
                                    </a>
                                </li>

                                <li>
                                    <a class="dropdown-item"
                                       asp-controller="ChiTietGiaoHangs"
                                       asp-action="Index">

                                        <i class="bi bi-box2 me-2"></i>
                                        Chi tiết giao hàng
                                    </a>
                                </li>

                            </ul>
                        </li>


                        <!-- ================= THANH TOÁN ================= -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="ThanhToanDonMuas"
                               asp-action="Index">

                                <i class="bi bi-cash-coin me-1"></i>
                                Thanh toán
                            </a>
                        </li>


                        <!-- ================= LỊCH SỬ ================= -->
                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="LichSuTrangThais"
                               asp-action="Index">

                                <i class="bi bi-clock-history me-1"></i>
                                Lịch sử
                            </a>
                        </li>

                    </ul>


                    <!-- ================= TÀI KHOẢN ================= -->
                   @{
                    var vaiTroHienTai = Context.Session.GetString("VaiTro");
                    var hoTenHienTai = Context.Session.GetString("HoTen");
                    }
                    <ul class="navbar-nav">
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle user-box" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-person-circle me-1"></i>
                                @(hoTenHienTai ?? "Tài khoản")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (vaiTroHienTai == "Admin")
                                {
                                    <li>
                                        <a class="dropdown-item" asp-controller="TaiKhoans" asp-action="Index">
                                            <i class="bi bi-people me-2"></i>
                                            Quản lý tài khoản
                                        </a>
                                    </li>
                                    <li><hr class="dropdown-divider" /></li>
                                }
                                <li>
                                    <a class="dropdown-item text-danger" asp-controller="TaiKhoans" asp-action="DangXuat">
                                        <i class="bi bi-box-arrow-right me-2"></i>
                                        Đăng xuất
                                    </a>
                                </li>
                            </ul>
                        </li>
                    </ul>

                </div>
            </div>
        </nav>
    </header>


    <!-- ================= NỘI DUNG ================= -->
    <div class="container-fluid px-4 main-content">

        <main role="main">

            @RenderBody()

        </main>

    </div>


    <!-- ================= FOOTER ================= -->
    <footer class="main-footer">

        <div class="container-fluid px-4">

            <div class="d-flex justify-content-between align-items-center">

                <span>
                    <i class="bi bi-cart-check me-1"></i>
                    &copy; 2026 - Hệ thống Quản lý Mua hàng
                </span>

                <span>
                    QLMuaHangVaNCC
                </span>

            </div>

        </div>

    </footer>


    <!-- ================= JAVASCRIPT ================= -->

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/layout.js"
            asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>