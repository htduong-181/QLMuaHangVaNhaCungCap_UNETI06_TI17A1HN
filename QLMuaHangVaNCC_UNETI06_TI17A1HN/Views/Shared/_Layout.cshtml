@{
    var vaiTroHienTai = Context.Session.GetString("VaiTro");
    var hoTenHienTai = Context.Session.GetString("HoTen");
    var controllerHienTai = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Home";
    var actionHienTai = ViewContext.RouteData.Values["action"]?.ToString() ?? "Index";

    var menu = new[] {
        new { Title="Tổng quan", Items=new[] { 
            ("Home", "Index", "Trang chủ", "house-door-fill"), 
            ("ThongKe", "Dashboard", "Dashboard nghiệp vụ", "speedometer2"),
            ("ThongKe", "ThongKeGiaoHang", "Thống kê giao hàng", "truck"),
            ("ThongKe", "Index", "Báo cáo thống kê", "bar-chart-line-fill") 
        } },
        new { Title="Danh mục", Items=new[] { 
            ("HangHoas", "Index", "Hàng hóa", "box-seam"), 
            ("LoaiHangs", "Index", "Loại hàng", "tags"), 
            ("DonViTinhs", "Index", "Đơn vị tính", "rulers"), 
            ("BoPhanDeNghis", "Index", "Bộ phận đề nghị", "building") 
        } },
        new { Title="Nhà cung cấp", Items=new[] { 
            ("NhaCungCaps", "Index", "Danh sách NCC", "truck"), 
            ("NhaCungCapHangHoas", "Index", "NCC - Hàng hóa", "boxes") 
        } },
        new { Title="Mua hàng", Items=new[] { 
            ("YeuCauMuaHangs", "Index", "Yêu cầu mua hàng", "file-earmark-text"), 
            ("ChiTietYeuCaus", "Index", "Chi tiết yêu cầu", "list-check"), 
            ("DonMuaHangs", "Index", "Đơn mua hàng", "cart-check"), 
            ("ChiTietDonMuas", "Index", "Chi tiết đơn mua", "receipt") 
        } },
        new { Title="Giao hàng & thanh toán", Items=new[] { 
            ("LanGiaoHangs", "Index", "Lần giao hàng", "truck-flatbed"), 
            ("ChiTietGiaoHangs", "Index", "Chi tiết giao hàng", "box-arrow-in-down"), 
            ("ThanhToanDonMuas", "Index", "Thanh toán", "cash-coin") 
        } },
        new { Title="Hệ thống", Items=new[] { 
            ("LichSuTrangThais", "Index", "Lịch sử trạng thái", "clock-history") 
        } }
    };
}<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý mua hàng</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/QLMuaHangVaNCC_UNETI06_TI17A1HN.styles.css" asp-append-version="true" />
</head>
<body class="admin-body">
    <header class="admin-topbar">
        <a class="admin-brand" asp-controller="Home" asp-action="Index"><i class="bi bi-cart-check-fill"></i><span>QUẢN LÝ MUA HÀNG</span></a>
        <button class="admin-menu-toggle" id="sidebarToggle" type="button" aria-label="Mở hoặc đóng menu" aria-controls="adminSidebar" aria-expanded="false"><i class="bi bi-list"></i></button>
        <div class="admin-top-title"><i class="bi bi-grid-1x2-fill me-2"></i>Hệ thống quản lý mua hàng và nhà cung cấp</div>
        <div class="dropdown ms-auto">
            <button type="button" class="admin-user dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-person-circle me-1"></i> @(hoTenHienTai ?? "Tài khoản")</button>
            <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                @if (vaiTroHienTai == "Admin") {
                    <li><a class="dropdown-item" asp-controller="TaiKhoans" asp-action="Index"><i class="bi bi-people me-2"></i>Quản lý tài khoản</a></li>
                    <li><hr class="dropdown-divider" /></li>
                }
                <li><a class="dropdown-item text-danger" asp-controller="TaiKhoans" asp-action="DangXuat"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</a></li>
            </ul>
        </div>
    </header>
    
    <div id="sidebarBackdrop" class="admin-backdrop"></div>
    <aside id="adminSidebar" class="admin-sidebar" aria-label="Điều hướng chính">
        <div class="admin-sidebar-heading"><i class="bi bi-grid me-2"></i>MENU QUẢN LÝ</div>
        <nav>
            @foreach(var group in menu) {
                <div class="admin-nav-group-title">@group.Title</div>
                @foreach(var item in group.Items) {
                    <a class="admin-nav-link @(controllerHienTai == item.Item1 && actionHienTai == item.Item2 ? "active" : "")" asp-controller="@item.Item1" asp-action="@item.Item2">
                        <i class="bi bi-@item.Item4"></i><span>@item.Item3</span>
                    </a>
                }
            }
            @if(vaiTroHienTai == "Admin") {
                <div class="admin-nav-group-title">Quản trị</div>
                <a class="admin-nav-link @(controllerHienTai == "TaiKhoans" ? "active" : "")" asp-controller="TaiKhoans" asp-action="Index"><i class="bi bi-people"></i><span>Tài khoản</span></a>
            }
        </nav>
    </aside>

    <div class="admin-main">
        <div class="admin-page-bar">
            <span><i class="bi bi-house-door me-1"></i> Hệ thống / <strong>@(ViewData["Title"] ?? "Trang chủ")</strong></span>
            <span class="d-none d-md-inline"><i class="bi bi-calendar3 me-1"></i>@DateTime.Now.ToString("dd/MM/yyyy")</span>
        </div>
        
        <main class="main-content" role="main">@RenderBody()</main>
        
        <footer class="main-footer">
            <span>© @DateTime.Now.Year - Hệ thống Quản lý Mua hàng và Nhà cung cấp</span>
            <span>QLMuaHangVaNCC</span>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/layout.js" asp-append-version="true"></script>
    <script src="~/js/admin-ui.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>