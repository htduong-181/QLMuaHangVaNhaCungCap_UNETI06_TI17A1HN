@* Họ và tên: Trương Huy Đồng *@
@* Mã sinh viên: 23103100036 *@
@* Nội dung thực hiện: Module 5 - Giao diện Dashboard thống kê *@

@model QLMuaHangVaNCC_UNETI06_TI17A1HN.Controllers.DashboardVM
@{
    ViewData["Title"] = "Dashboard Thống Kê";
}

<div class="container-fluid mt-4 admin-stats-view">
    <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
        <h3 class="fw-bold text-primary"><i class="bi bi-speedometer"></i> BẢNG ĐIỀU KHIỂN & THỐNG KÊ (DASHBOARD)</h3>
    </div>

    <!-- HÀNG 1: TỔNG QUAN TÀI CHÍNH & HOẠT ĐỘNG (4 CHỈ SỐ) -->
    <div class="row g-3 mb-4 stats-colorful-row">
        <div class="col-md-3">
            <div class="card stat-highlight h-100 shadow-sm">
                <div class="card-body text-center bg-light">
                    <h6 class="text-muted text-uppercase fw-bold">NCC Đang Hoạt Động</h6>
                    <h2 class="fw-bold text-primary mt-3">@Model.TongNCCDangHoatDong</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-highlight h-100 shadow-sm">
                <div class="card-body text-center bg-light">
                    <h6 class="text-muted text-uppercase fw-bold">Mua Trong Tháng @DateTime.Now.Month</h6>
                    <h4 class="fw-bold text-success mt-3">@Model.TongGiaTriMuaTrongThang.ToString("N0") đ</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-highlight h-100 shadow-sm">
                <div class="card-body text-center bg-light">
                    <h6 class="text-muted text-uppercase fw-bold">Tổng Nợ Cần Thanh Toán</h6>
                    <h4 class="fw-bold text-warning mt-3">@Model.TongTienConPhaiThanhToan.ToString("N0") đ</h4>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card stat-highlight h-100 shadow-sm">
                <div class="card-body text-center bg-light">
                    <h6 class="text-muted text-uppercase fw-bold">Đơn Đang Chậm Giao</h6>
                    <h2 class="fw-bold text-danger mt-3">@Model.SoDonChamGiao</h2>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG 2: TRẠNG THÁI YÊU CẦU & ĐƠN MUA HÀNG -->
    <div class="row g-3 mb-4">
        <!-- Số yêu cầu Chờ duyệt/Đã duyệt/Từ chối -->
        <div class="col-md-5">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-info text-white fw-bold">Trạng Thái Yêu Cầu Mua Hàng</div>
                <div class="card-body d-flex justify-content-around text-center align-items-center py-4">
                    <div>
                        <h3 class="fw-bold text-warning">@Model.SoYeuCauChoDuyet</h3>
                        <span class="text-muted fw-bold">Chờ duyệt</span>
                    </div>
                    <div>
                        <h3 class="fw-bold text-success">@Model.SoYeuCauDaDuyet</h3>
                        <span class="text-muted fw-bold">Đã duyệt</span>
                    </div>
                    <div>
                        <h3 class="fw-bold text-danger">@Model.SoYeuCauTuChoi</h3>
                        <span class="text-muted fw-bold">Từ chối</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Số đơn Đã đặt hàng/Giao một phần/Đã giao đủ/Hoàn thành -->
        <div class="col-md-7">
            <div class="card shadow-sm h-100 border-0">
                <div class="card-header bg-secondary text-white fw-bold">Tiến Độ Đơn Mua Hàng</div>
                <div class="card-body d-flex justify-content-around text-center align-items-center py-4">
                    <div>
                        <h3 class="fw-bold text-primary">@Model.SoDonDaDatHang</h3>
                        <span class="text-muted fw-bold">Đã đặt hàng</span>
                    </div>
                    <div>
                        <h3 class="fw-bold text-warning">@Model.SoDonGiaoMotPhan</h3>
                        <span class="text-muted fw-bold">Giao một phần</span>
                    </div>
                    <div>
                        <h3 class="fw-bold text-info">@Model.SoDonDaGiaoDu</h3>
                        <span class="text-muted fw-bold">Đã giao đủ</span>
                    </div>
                    <div>
                        <h3 class="fw-bold text-success">@Model.SoDonHoanThanh</h3>
                        <span class="text-muted fw-bold">Hoàn thành</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- HÀNG 3: CÁC YÊU CẦU MỨC ƯU TIÊN CAO -->
    <div class="card shadow-sm border-0 mb-4">
        <div class="card-header bg-danger text-white fw-bold">
            <i class="bi bi-exclamation-triangle"></i> Danh Sách Yêu Cầu Mức Ưu Tiên Cao Đang Chờ Xử Lý
        </div>
        <div class="card-body p-3">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-datatable">
                    <thead class="table-light text-center">
                        <tr>
                            <th>Mã YC</th>
                            <th>Bộ phận đề nghị</th>
                            <th>Ngày yêu cầu</th>
                            <th>Ngày cần hàng</th>
                            <th>Mức ưu tiên</th>
                            <th>Trạng thái</th>
                            <th>Lý do mua</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if(Model.YeuCauUuTienCao != null && Model.YeuCauUuTienCao.Any())
                        {
                            foreach (var yc in Model.YeuCauUuTienCao)
                            {
                                <tr>
                                    <td class="text-center fw-bold">#@yc.MaYeuCau</td>
                                    <td>@yc.BoPhanDeNghi?.TenBoPhan</td>
                                    <td class="text-center">@yc.NgayYeuCau.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center text-danger fw-bold">@yc.NgayCanHang.ToString("dd/MM/yyyy")</td>
                                    <td class="text-center"><span class="badge bg-danger">@yc.MucDoUuTien</span></td>
                                    <td class="text-center"><span class="badge bg-secondary">@yc.TrangThai</span></td>
                                    <td>@yc.LyDoMua</td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- CSS cho DataTables Bootstrap 5 -->
    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.6/css/dataTables.bootstrap5.min.css" />

    <!-- JS cho DataTables -->
    <script src="https://cdn.datatables.net/1.13.6/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.6/js/dataTables.bootstrap5.min.js"></script>

    <script>
        $(document).ready(function () {
            var languageVN = {
                "lengthMenu": "Hiển thị _MENU_ dòng",
                "search": "Tìm:",
                "zeroRecords": "Tuyệt vời! Hiện không có yêu cầu ưu tiên cao nào bị tồn đọng.",
                "info": "Trang _PAGE_ / _PAGES_",
                "infoEmpty": "Trống",
                "infoFiltered": "(lọc từ _MAX_ dòng)",
                "paginate": {
                    "first": "Đầu",
                    "last": "Cuối",
                    "next": "›",
                    "previous": "‹"
                }
            };

            // Khởi tạo DataTables cho bảng
            $('.table-datatable').DataTable({
                "language": languageVN,
                "pageLength": 5, 
                "lengthMenu": [5, 10, 20],
                "ordering": true, 
                "info": false, 
                "lengthChange": true
            });
        });
    </script>
}