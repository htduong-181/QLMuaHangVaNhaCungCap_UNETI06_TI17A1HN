@model QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.LanGiaoHang

@{
    ViewData["Title"] = "Tạo lần giao hàng";
}

<div class="container mt-4">
    <div class="card shadow-sm">
        <div class="card-header">
            <h4 class="mb-0">Tạo lần giao hàng</h4>
        </div>

        <div class="card-body">

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <form asp-action="Create" method="post">

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="MaDonMua" class="form-label">
                            Đơn mua hàng
                        </label>

                        <select asp-for="MaDonMua"
                                class="form-select">
                            <option value="">-- Chọn đơn mua hàng --</option>

                            @if (ViewBag.DonMuaHangs != null)
                            {
                                foreach (var don in ViewBag.DonMuaHangs)
                                {
                                    <option value="@don.MaDonMua">
                                        Đơn #@don.MaDonMua -
                                        @(don.NhaCungCap?.TenNhaCungCap ?? "Không có NCC")
                                    </option>
                                }
                            }
                        </select>

                        <span asp-validation-for="MaDonMua"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="NguoiNhan" class="form-label">
                            Người nhận
                        </label>

                        <select asp-for="NguoiNhan"
                                class="form-select">
                            <option value="">-- Chọn người nhận --</option>

                            @if (ViewBag.TaiKhoans != null)
                            {
                                foreach (var tk in ViewBag.TaiKhoans)
                                {
                                    <option value="@tk.MaTaiKhoan">
                                        @tk.HoTen
                                    </option>
                                }
                            }
                        </select>

                        <span asp-validation-for="NguoiNhan"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="NgayGiao" class="form-label">
                            Ngày giao
                        </label>

                        <input asp-for="NgayGiao"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="NgayGiao"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="SoChungTu" class="form-label">
                            Số chứng từ
                        </label>

                        <input asp-for="SoChungTu"
                               class="form-control"
                               placeholder="Nhập số chứng từ nếu có" />

                        <span asp-validation-for="SoChungTu"
                              class="text-danger"></span>
                    </div>

                    <div class="col-12 mb-3">
                        <label asp-for="GhiChu" class="form-label">
                            Ghi chú
                        </label>

                        <textarea asp-for="GhiChu"
                                  class="form-control"
                                  rows="4"
                                  placeholder="Nhập ghi chú..."></textarea>

                        <span asp-validation-for="GhiChu"
                              class="text-danger"></span>
                    </div>

                </div>

                <div class="d-flex gap-2">
                    <button type="submit"
                            class="btn btn-primary">
                        Tạo lần giao
                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Quay lại
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}