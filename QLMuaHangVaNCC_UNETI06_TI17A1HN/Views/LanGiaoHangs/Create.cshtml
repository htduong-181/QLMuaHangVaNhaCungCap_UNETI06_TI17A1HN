@model QLMuaHangVaNCC_UNETI06_TI17A1HN.ViewModels.LanGiaoHangVM
@{
    ViewData["Title"] = "Ghi nhận lần giao";
}

<h2>Ghi nhận lần giao</h2>

<div class="mb-3">
    <label class="form-label">Đơn mua</label>
    <select class="form-select" asp-items="ViewBag.DonMua"
            onchange="location.href='@Url.Action("Create")?maDonMua=' + this.value">
        <option value="">-- Chọn đơn mua --</option>
    </select>
</div>

@if (Model.ChiTiets.Any())
{
    <form asp-action="Create" method="post">
        <div asp-validation-summary="All" class="text-danger"></div>
        <input type="hidden" asp-for="MaDonMua" />

        <div class="row mb-3">
            <div class="col-md-3">
                <label asp-for="NgayGiao" class="form-label">Ngày giao</label>
                <input asp-for="NgayGiao" type="date" class="form-control" />
                <span asp-validation-for="NgayGiao" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="NguoiNhan" class="form-label">Người nhận</label>
                <select asp-for="NguoiNhan" class="form-select" asp-items="ViewBag.NguoiNhan">
                    <option value="0">-- Chọn người nhận --</option>
                </select>
                <span asp-validation-for="NguoiNhan" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="SoChungTu" class="form-label">Số chứng từ</label>
                <input asp-for="SoChungTu" class="form-control" />
                <span asp-validation-for="SoChungTu" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="GhiChu" class="form-label">Ghi chú</label>
                <input asp-for="GhiChu" class="form-control" />
                <span asp-validation-for="GhiChu" class="text-danger"></span>
            </div>
        </div>

        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Mặt hàng</th>
                    <th>Số lượng đặt</th>
                    <th>Đã nhận</th>
                    <th>Còn phải giao</th>
                    <th>Số lượng nhận</th>
                    <th>Số lượng đạt chất lượng</th>
                    <th>Ghi chú</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < Model.ChiTiets.Count; i++)
                {
                    <tr>
                        <td>
                            @Model.ChiTiets[i].TenHang
                            <input type="hidden" asp-for="ChiTiets[i].MaChiTietDon" />
                        </td>
                        <td>@Model.ChiTiets[i].SoLuongDat</td>
                        <td>@Model.ChiTiets[i].TongDaNhan</td>
                        <td>@Model.ChiTiets[i].ConPhaiGiao</td>
                        <td>
                            <input asp-for="ChiTiets[i].SoLuongNhan" type="number" min="0"
                                   max="@Model.ChiTiets[i].ConPhaiGiao" class="form-control" />
                        </td>
                        <td>
                            <input asp-for="ChiTiets[i].SoLuongDatChatLuong" type="number" min="0" class="form-control" />
                        </td>
                        <td>
                            <input asp-for="ChiTiets[i].GhiChu" class="form-control" />
                        </td>
                    </tr>
                }
            </tbody>
        </table>

        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
    </form>
}
else
{
    <p class="text-muted">Chọn một đơn mua để hiển thị các mặt hàng cần nhận.</p>
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}