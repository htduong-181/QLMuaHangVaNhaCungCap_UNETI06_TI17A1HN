@model IEnumerable<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.LanGiaoHang>

@{
    ViewData["Title"] = "Lần giao hàng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Lần giao hàng</h1>
    <a asp-action="Create" class="btn btn-primary">Ghi nhận lần giao</a>
</div>

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">@TempData["Loi"]</div>
}
@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success">@TempData["ThanhCong"]</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle text-center mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Mã lần giao</th>
                    <th>Mã đơn mua</th>
                    <th>Trạng thái đơn</th>
                    <th>Ngày giao</th>
                    <th>Người nhận</th>
                    <th>Số chứng từ</th>
                    <th>Tổng SL nhận</th>
                    <th>Ghi chú</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var choPhep = item.TrangThai
     && item.DonMuaHang != null
     && item.DonMuaHang.TrangThai != "HoanThanh"
     && item.DonMuaHang.TrangThai != "DaHuy";
                    <tr>
                        <td>@item.MaLanGiao</td>
                        <td>
                            <a asp-action="DoiChieu" asp-route-maDonMua="@item.MaDonMua">@item.MaDonMua</a>
                        </td>
                        <td>@item.DonMuaHang?.TrangThai</td>
                        <td>@item.NgayGiao.ToString("dd/MM/yyyy")</td>
                        <td>@(item.NguoiNhanNavigation?.HoTen ?? item.NguoiNhan.ToString())</td>
                        <td>@item.SoChungTu</td>
                        <td>@item.ChiTietGiaoHangs.Sum(c => c.SoLuongNhan)</td>
                        <td>@item.GhiChu</td>
                        <td>
                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success">Còn hiệu lực</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đã vô hiệu</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            @if (choPhep)
                            {
                                <a asp-action="Edit" asp-route-malangiao="@item.MaLanGiao" class="btn btn-sm btn-outline-primary">Sửa</a>
                            }
                            <a asp-action="Details" asp-route-malangiao="@item.MaLanGiao" class="btn btn-sm btn-outline-info">Chi tiết</a>
                            @if (choPhep)
                            {
                                <a asp-action="Delete" asp-route-malangiao="@item.MaLanGiao" class="btn btn-sm btn-outline-danger">Vô hiệu</a>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-muted py-4">Chưa có lần giao nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>