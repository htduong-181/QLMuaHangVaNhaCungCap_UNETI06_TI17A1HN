@model IEnumerable<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.LanGiaoHang>

@{
    ViewData["Title"] = "Lần giao hàng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Lần giao hàng</h1>
    <div class="dropdown d-inline-block mb-3"><button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-circle me-1"></i> Thêm / Tạo mới</button><div class="dropdown-menu dropdown-menu-end"><a asp-action="Create" class="dropdown-item">Ghi nhận lần giao</a></div></div>
</div>

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">@TempData["Loi"]</div>
}
@if (TempData["ThanhCong"] != null)
{
    <div class="alert alert-success">@TempData["ThanhCong"]</div>
}

<div class="card shadow-sm">
    <div class="table-responsive">
        <table id="tableLanGiaoHang" class="table table-hover table-striped align-middle text-center mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Mã lần giao</th>
                    <th>Mã đơn mua</th>
                    <th>Trạng thái đơn</th>
                    <th>Ngày giao</th>
                    <th>Người nhận</th>
                    <th>Số chứng từ</th>
                    <th>Tổng SL nhận</th>
                    <th>Ghi chú</th>
                    <th>Trạng thái</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    var choPhep = item.TrangThai
     && item.DonMuaHang != null
     && item.DonMuaHang.TrangThai != "HoanThanh"
     && item.DonMuaHang.TrangThai != "DaHuy";
                    <tr>
                        <td>@item.MaLanGiao</td>
                        <td>
                            <a asp-action="DoiChieu" asp-route-maDonMua="@item.MaDonMua">@item.MaDonMua</a>
                        </td>
                        <td>@item.DonMuaHang?.TrangThai</td>
                        <td>@item.NgayGiao.ToString("dd/MM/yyyy")</td>
                        <td>@(item.NguoiNhanNavigation?.HoTen ?? item.NguoiNhan.ToString())</td>
                        <td>@item.SoChungTu</td>
                        <td>@item.ChiTietGiaoHangs.Sum(c => c.SoLuongNhan)</td>
                        <td>@item.GhiChu</td>
                        <td>
                            @if (item.TrangThai)
                            {
                                <span class="badge bg-success">Còn hiệu lực</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Đã vô hiệu</span>
                            }
                        </td>
                        <td class="text-nowrap"><div class="dropdown d-inline-block"><button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false"><i class="bi bi-three-dots-vertical me-1"></i>Thao tác</button><div class="dropdown-menu dropdown-menu-end">@if (choPhep)
                            {
                                <a asp-action="Edit" asp-route-malangiao="@item.MaLanGiao" class="dropdown-item">Sửa</a>
                            }
                            <a asp-action="Details" asp-route-malangiao="@item.MaLanGiao" class="dropdown-item">Chi tiết</a>
                            @if (choPhep)
                            {
                                <a asp-action="Delete" asp-route-malangiao="@item.MaLanGiao" class="dropdown-item">Vô hiệu</a>
                            }</div></div></td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="10" class="text-muted py-4">Chưa có lần giao nào.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
<!-- Vị trí hiển thị nút phân trang -->
<div id="paginationLanGiaoHang"></div>

<!-- Nhúng JavaScript dùng chung -->
<script src="~/js/pagination.js" asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        initPagination({
            table: "#tableLanGiaoHang",
            pagination: "#paginationLanGiaoHang",
            pageSize: 5
        });
    });
</script>