@model IEnumerable<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.ChiTietYeuCau>
@{ ViewData["Title"] = "Chi tiết yêu cầu"; }

<h3>Chi tiết yêu cầu mua hàng</h3>

@if (TempData["ThongBao"] != null) { <div class="alert alert-success">@TempData["ThongBao"]</div> }

<form method="get" class="d-flex gap-2 mb-3">
    <input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tên hàng hóa" style="max-width:300px" />
    <button class="btn btn-outline-primary">Tìm</button>
</form>

<table id="tableChiTietYeuCau" class="table table-bordered table-hover">
    <thead class="table-light">
        <tr><th>Mã yêu cầu</th><th>Hàng hóa</th><th>Đơn vị tính</th><th>SL yêu cầu</th><th>SL duyệt</th><th>Ghi chú</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td><a asp-controller="YeuCauMuaHangs" asp-action="Details" asp-route-id="@c.MaYeuCau">#@c.MaYeuCau</a></td>
            <td>@c.HangHoa.TenHang</td>
            <td>@c.HangHoa.DonViTinh.TenDonViTinh</td>
            <td>@c.SoLuongYeuCau</td>
            <td>@c.SoLuongDuyet</td>
            <td>@c.GhiChu</td>
            <td class="text-nowrap"><div class="dropdown d-inline-block"><button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false"><i class="bi bi-three-dots-vertical me-1"></i>Thao tác</button><div class="dropdown-menu dropdown-menu-end"><a asp-controller="YeuCauMuaHangs" asp-action="Details" asp-route-id="@c.MaYeuCau" class="dropdown-item">Xem yêu cầu</a></div></div></td>
        </tr>
    }
    @if (!Model.Any())
    {
        <tr><td colspan="7" class="text-center text-muted">Không có dữ liệu</td></tr>
    }
    </tbody>
</table>
<!-- Vị trí hiển thị nút phân trang -->
<div id="paginationChiTietYeuCau"></div>

<!-- Nhúng JavaScript dùng chung -->
<script src="~/js/pagination.js" asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        initPagination({
            table: "#tableChiTietYeuCau",
            pagination: "#paginationChiTietYeuCau",
            pageSize: 5
        });
    });
</script>