@model IEnumerable<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.BoPhanDeNghi>
@{ ViewData["Title"] = "Bộ phận đề nghị"; }

<h3>Quản lý bộ phận đề nghị</h3>

@if (TempData["ThongBao"] != null) { <div class="alert alert-success">@TempData["ThongBao"]</div> }
@if (TempData["Loi"] != null) { <div class="alert alert-danger">@TempData["Loi"]</div> }

<div class="d-flex justify-content-between mb-3">
    <form method="get" class="d-flex gap-2">
        <input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tên bộ phận" />
        <button class="btn btn-outline-primary">Tìm</button>
    </form>
    <a asp-action="Create" class="btn btn-success">+ Thêm bộ phận</a>
</div>

<table class="table table-bordered table-hover">
    <thead class="table-light">
        <tr><th>Tên bộ phận</th><th>Người phụ trách</th><th>SĐT</th><th>Trạng thái</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.TenBoPhan</td>
            <td>@b.NguoiPhuTrach</td>
            <td>@b.SoDienThoai</td>
            <td>
                @if (b.TrangThai) { <span class="badge bg-success">Hoạt động</span> }
                else { <span class="badge bg-secondary">Ngừng</span> }
            </td>
            <td class="d-flex gap-1">
                <a asp-action="Edit" asp-route-id="@b.MaBoPhan" class="btn btn-sm btn-primary">Sửa</a>
                <form asp-action="DoiTrangThai" asp-route-id="@b.MaBoPhan" method="post">
                    <button class="btn btn-sm btn-warning">@(b.TrangThai ? "Ngừng" : "Kích hoạt")</button>
                </form>
                <form asp-action="Delete" asp-route-id="@b.MaBoPhan" method="post"
                      onsubmit="return confirm('Xóa bộ phận này?')">
                    <button class="btn btn-sm btn-danger">Xóa</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
