@model IEnumerable<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.BoPhanDeNghi>
@{ ViewData["Title"] = "Bộ phận đề nghị"; }

<h3>Quản lý bộ phận đề nghị</h3>

@if (TempData["ThongBao"] != null) { <div class="alert alert-success">@TempData["ThongBao"]</div> }
@if (TempData["Loi"] != null) { <div class="alert alert-danger">@TempData["Loi"]</div> }

<div class="d-flex justify-content-between mb-3">
    <form method="get" class="d-flex gap-2">
        <input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tên bộ phận" />
        <button class="btn btn-outline-primary">Tìm</button>
    </form>
    <div class="dropdown d-inline-block mb-3"><button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-circle me-1"></i> Thêm / Tạo mới</button><div class="dropdown-menu dropdown-menu-end"><a asp-action="Create" class="dropdown-item">+ Thêm bộ phận</a></div></div>
</div>

<table id="tableBoPhanDeNghi" class="table table-bordered table-hover">
    <thead class="table-light">
        <tr><th>Tên bộ phận</th><th>Người phụ trách</th><th>SĐT</th><th>Trạng thái</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var b in Model)
    {
        <tr>
            <td>@b.TenBoPhan</td>
            <td>@b.NguoiPhuTrach</td>
            <td>@b.SoDienThoai</td>
            <td>
                @if (b.TrangThai) { <span class="badge bg-success">Hoạt động</span> }
                else { <span class="badge bg-secondary">Ngừng</span> }
            </td>
            <td class="text-nowrap"><div class="dropdown d-inline-block"><button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false"><i class="bi bi-three-dots-vertical me-1"></i>Thao tác</button><div class="dropdown-menu dropdown-menu-end"><a asp-action="Edit" asp-route-id="@b.MaBoPhan" class="dropdown-item">Sửa</a>
                <form asp-action="DoiTrangThai" asp-route-id="@b.MaBoPhan" method="post">
                    <button class="dropdown-item">@(b.TrangThai ? "Ngừng" : "Kích hoạt")</button>
                </form>
                <form asp-action="Delete" asp-route-id="@b.MaBoPhan" method="post"
                      onsubmit="return confirm('Xóa bộ phận này?')">
                    <button class="dropdown-item">Xóa</button>
                </form></div></div></td>
        </tr>
    }
    </tbody>
</table>
<!-- Vị trí hiển thị nút phân trang -->
<div id="paginationBoPhanDeNghi"></div>

<!-- Nhúng JavaScript dùng chung -->
<script src="~/js/pagination.js" asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        initPagination({
            table: "#tableBoPhanDeNghi",
            pagination: "#paginationBoPhanDeNghi",
            pageSize: 5
        });
    });
</script>
