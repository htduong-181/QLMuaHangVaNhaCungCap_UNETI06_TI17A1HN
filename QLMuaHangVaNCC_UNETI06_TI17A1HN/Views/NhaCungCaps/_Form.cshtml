@model QLMuaHangVaNCC_UNETI06_TI17A1HN.ViewModels.NhaCungCapFormVm
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
<div class="mb-3"><label asp-for="TenNhaCungCap" class="form-label">Tên nhà cung cấp</label>
<input asp-for="TenNhaCungCap" type="text"  class="form-control" />
<span asp-validation-for="TenNhaCungCap" class="text-danger"></span></div>
<div class="mb-3"><label asp-for="MaSoThue" class="form-label">Mã số thuế</label>
