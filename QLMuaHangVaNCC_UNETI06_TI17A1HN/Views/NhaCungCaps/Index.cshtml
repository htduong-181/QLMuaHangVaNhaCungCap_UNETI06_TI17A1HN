@model QLMuaHangVaNCC_UNETI06_TI17A1HN.ViewModels.PagedListVm<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.NhaCungCap>
@{ ViewData["Title"] = "Nhà cung cấp"; }

<h2 class="mb-3">Nhà cung cấp</h2>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="dropdown d-inline-block mb-3">
    <button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-circle me-1"></i> Thêm / Tạo mới</button>
    <div class="dropdown-menu dropdown-menu-end"><a asp-action="Create" class="dropdown-item"><i class="bi bi-plus-circle"></i> Thêm mới</a></div>
</div>

<form method="get" asp-action="Index" class="card card-body mb-3 shadow-sm border-0">
    <div class="row g-2">
        <div class="col-md-3"><input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Tìm tên, mã và thông tin liên quan" /></div>
        <div class="col-md-3">
            <select name="maHang" class="form-select">
                <option value="">Chọn mặt hàng để lọc cung ứng</option>
                @foreach (var x in Model.HangHoas) { <option value="@x.MaHang" selected="@(Model.MaHang == x.MaHang)">@x.TenHang</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select name="coCungUng" class="form-select">
                <option value="">Cung ứng: Tất cả</option>
                <option value="true" selected="@(Model.CoCungUng == true)">Có cung ứng</option>
                <option value="false" selected="@(Model.CoCungUng == false)">Không cung ứng</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">Mọi trạng thái</option>
                <option value="true" selected="@(Model.Status == true)">Hoạt động</option>
                <option value="false" selected="@(Model.Status == false)">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="sort" class="form-select">
                <option value="">Sắp xếp mặc định</option>
                <option value="name_asc" selected="@(Model.Sort == "name_asc")">Tên A-Z</option>
                <option value="name_desc" selected="@(Model.Sort == "name_desc")">Tên Z-A</option>
            </select>
        </div>
        <div class="col-md-auto">
            <button class="btn btn-primary" type="submit">Lọc / Tìm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </div>
</form>

<div class="table-responsive shadow-sm">
    <table class="table table-hover table-bordered align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Mã</th>
                <th>Nhà cung cấp</th>
                <th>Mã số thuế</th>
                <th>Điện thoại</th>
                <th>Người liên hệ</th>
                <th>Trạng thái</th>
                <th class="text-center">Thao tác</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items) {
                <!-- DÒNG THÔNG TIN CHÍNH -->
                <tr>
                    <td class="fw-bold text-center">@item.MaNhaCungCap</td>
                    <td class="fw-bold text-primary">@item.TenNhaCungCap</td>
                    <td>@item.MaSoThue</td>
                    <td>@item.SoDienThoai</td>
                    <td>@item.NguoiLienHe</td>
                    <td class="text-center"><span class="badge @(item.TrangThai ? "bg-success" : "bg-secondary")">@(item.TrangThai ? "Hoạt động" : "Ngừng")</span></td>
                    <td class="text-nowrap text-center">
                        
                        <!-- NÚT SỔ XUỐNG -->
                        <button type="button" class="btn btn-sm btn-info text-white me-1 shadow-sm" data-bs-toggle="collapse" data-bs-target="#collapseHistory-@item.MaNhaCungCap" aria-expanded="false" title="Mở lịch sử">
                            <i class="bi bi-chevron-down fw-bold"></i> Lịch sử
                        </button>

                        <!-- MENU THAO TÁC CÒN LẠI -->
                        <div class="dropdown d-inline-block">
                            <button type="button" class="btn btn-sm btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false">
                                <i class="bi bi-gear"></i>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end">
                                <a asp-action="Details" asp-route-id="@item.MaNhaCungCap" class="dropdown-item">Chi tiết</a>
                                <a asp-action="Edit" asp-route-id="@item.MaNhaCungCap" class="dropdown-item">Sửa</a>
                                <form method="post" asp-action="ChangeStatus" asp-route-id="@item.MaNhaCungCap">
                                    <button type="submit" class="dropdown-item">Đổi trạng thái</button>
                                </form>
                                <div class="dropdown-divider"></div>
                                <a asp-action="Delete" asp-route-id="@item.MaNhaCungCap" class="dropdown-item text-danger">Xóa</a>
                            </div>
                        </div>
                        
                    </td>
                </tr>

                <!-- DÒNG COLLAPSE ẨN CHỨA BẢNG DỮ LIỆU -->
                <tr id="collapseHistory-@item.MaNhaCungCap" class="collapse bg-light">
                    <td colspan="7" class="p-0 border-bottom-0">
                        <div class="p-3 m-2 border rounded bg-white shadow-sm">
                            <h6 class="fw-bold text-primary mb-3"><i class="bi bi-clock-history me-1"></i> Lịch sử giao dịch: @item.TenNhaCungCap</h6>
                            
                            <div class="table-responsive">
                                @if(item.DonMuaHangs != null && item.DonMuaHangs.Any())
                                {
                                    <table class="table table-sm table-bordered mb-0">
                                        <thead class="table-secondary">
                                            <tr>
                                                <th class="text-center">Mã Đơn</th>
                                                <th class="text-center">Ngày Đặt</th>
                                                <th class="text-center">Trạng Thái</th>
                                                <th class="text-end">Tổng Tiền</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach(var don in item.DonMuaHangs)
                                            {
                                                <tr>
                                                    <td class="text-center fw-bold">#@don.MaDonMua</td>
                                                    <td class="text-center">@don.NgayDat.ToString("dd/MM/yyyy")</td>
                                                    <td class="text-center">@don.TrangThai</td>
                                                    <td class="text-end fw-bold text-danger">@don.TongTien.ToString("N0") đ</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                }
                                else
                                {
                                    <div class="text-center text-muted py-3">
                                        <i class="bi bi-inbox fs-4 d-block mb-1"></i>
                                        <em>Chưa có dữ liệu lịch sử đơn hàng nào với nhà cung cấp này.</em>
                                    </div>
                                }
                            </div>
                        </div>
                    </td>
                </tr>
            }
            @if (!Model.Items.Any()) {
                <tr><td colspan="7" class="text-center text-muted py-4">Không có dữ liệu nhà cung cấp phù hợp</td></tr>
            }
        </tbody>
    </table>
</div>

@{
    int maxPagesToShow = 5;
    int startPage = Math.Max(1, Model.Page - maxPagesToShow / 2);
    int endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);
    if (endPage - startPage + 1 < maxPagesToShow) {
        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
    }
}
<div class="d-flex justify-content-center mt-4">
    <nav>
        <ul class="pagination mb-0 gap-1 shadow-sm">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link rounded" asp-action="Index" asp-route-page="1" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-maHang="@Model.MaHang" asp-route-maNhaCungCap="@Model.MaNhaCungCap" asp-route-maLoaiHang="@Model.MaLoaiHang" asp-route-maDonViTinh="@Model.MaDonViTinh" asp-route-giaTu="@Model.GiaTu" asp-route-giaDen="@Model.GiaDen" asp-route-coCungUng="@Model.CoCungUng">«</a>
            </li>
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link rounded" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-maHang="@Model.MaHang" asp-route-maNhaCungCap="@Model.MaNhaCungCap" asp-route-maLoaiHang="@Model.MaLoaiHang" asp-route-maDonViTinh="@Model.MaDonViTinh" asp-route-giaTu="@Model.GiaTu" asp-route-giaDen="@Model.GiaDen" asp-route-coCungUng="@Model.CoCungUng">‹</a>
            </li>

            @for (int p = startPage; p <= endPage; p++) {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link rounded" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-maHang="@Model.MaHang" asp-route-maNhaCungCap="@Model.MaNhaCungCap" asp-route-maLoaiHang="@Model.MaLoaiHang" asp-route-maDonViTinh="@Model.MaDonViTinh" asp-route-giaTu="@Model.GiaTu" asp-route-giaDen="@Model.GiaDen" asp-route-coCungUng="@Model.CoCungUng">@p</a>
                </li>
            }

            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link rounded" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-maHang="@Model.MaHang" asp-route-maNhaCungCap="@Model.MaNhaCungCap" asp-route-maLoaiHang="@Model.MaLoaiHang" asp-route-maDonViTinh="@Model.MaDonViTinh" asp-route-giaTu="@Model.GiaTu" asp-route-giaDen="@Model.GiaDen" asp-route-coCungUng="@Model.CoCungUng">›</a>
            </li>
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link rounded" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-maHang="@Model.MaHang" asp-route-maNhaCungCap="@Model.MaNhaCungCap" asp-route-maLoaiHang="@Model.MaLoaiHang" asp-route-maDonViTinh="@Model.MaDonViTinh" asp-route-giaTu="@Model.GiaTu" asp-route-giaDen="@Model.GiaDen" asp-route-coCungUng="@Model.CoCungUng">»</a>
            </li>
        </ul>
    </nav>
</div>
