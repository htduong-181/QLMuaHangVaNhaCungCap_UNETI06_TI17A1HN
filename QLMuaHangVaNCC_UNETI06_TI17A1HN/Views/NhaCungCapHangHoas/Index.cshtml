@model QLMuaHangVaNCC_UNETI06_TI17A1HN.ViewModels.PagedListVm<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.NhaCungCapHangHoa>
@{ ViewData["Title"] = "Quan hệ cung ứng"; }
<h2 class="mb-3">Quan hệ cung ứng</h2>
@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<a asp-action="Create" class="btn btn-primary mb-3"><i class="bi bi-plus-circle"></i> Thêm mới</a>
<form method="get" asp-action="Index" class="card card-body mb-3"><div class="row g-2">
<div class="col-md-3"><input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Tìm tên, mã và thông tin liên quan" /></div>
<div class="col-md-3"><select name="maHang" class="form-select"><option value="">Tất cả hàng hóa</option>@foreach (var x in Model.HangHoas) { <option value="@x.MaHang" selected="@(Model.MaHang == x.MaHang)">@x.TenHang</option> }</select></div>
<div class="col-md-3"><select name="maNhaCungCap" class="form-select"><option value="">Tất cả nhà cung cấp</option>@foreach (var x in Model.NhaCungCaps) { <option value="@x.MaNhaCungCap" selected="@(Model.MaNhaCungCap == x.MaNhaCungCap)">@x.TenNhaCungCap</option> }</select></div>
<div class="col-md-2"><select name="status" class="form-select"><option value="">Mọi trạng thái</option><option value="true" selected="@(Model.Status == true)">Hoạt động</option><option value="false" selected="@(Model.Status == false)">Ngừng hoạt động</option></select></div>
<div class="col-md-2"><select name="sort" class="form-select"><option value="">Sắp xếp mặc định</option><option value="date_desc" selected="@(Model.Sort == "date_desc")">Giá cập nhật mới</option><option value="date_asc" selected="@(Model.Sort == "date_asc")">Giá cập nhật cũ</option><option value="price_asc" selected="@(Model.Sort == "price_asc")">Giá tăng</option><option value="price_desc" selected="@(Model.Sort == "price_desc")">Giá giảm</option></select></div>
<div class="col-md-auto"><button class="btn btn-primary" type="submit">Lọc / Tìm</button> <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a></div></div></form>
<div class="table-responsive"><table class="table table-hover table-bordered align-middle"><thead class="table-light"><tr><th>ID</th><th>Nhà cung cấp</th><th>Hàng hóa</th><th>Đơn giá</th><th>Cập nhật</th><th>Ngày giao</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>
@foreach (var item in Model.Items) { <tr>
<td>@item.Id</td><td>@item.NhaCungCap.TenNhaCungCap</td><td>@item.HangHoa.TenHang</td><td>@item.DonGiaBao</td><td>@item.NgayCapNhatGia</td><td>@item.ThoiGianGiaoDuKien</td><td><span class="badge @(item.TrangThai ? "bg-success" : "bg-secondary")">@(item.TrangThai ? "Hoạt động" : "Ngừng")</span></td><td class="text-nowrap"><a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-info btn-sm">Chi tiết</a> <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-outline-primary btn-sm">Sửa</a> <form method="post" asp-action="ChangeStatus" asp-route-id="@item.Id" class="d-inline"><button type="submit" class="btn btn-outline-warning btn-sm">Đổi trạng thái</button></form> </td></tr> }
@if (!Model.Items.Any()) { <tr><td colspan="8" class="text-center text-muted">Không có dữ liệu phù hợp</td></tr> }</tbody></table></div>
<div class="d-flex justify-content-between align-items-center"><div>Tổng: @Model.TotalItems bản ghi — Trang @Model.Page / @Model.TotalPages</div><nav><ul class="pagination mb-0">
@for (int p = 1; p <= Model.TotalPages; p++) { <li class="page-item @(p == Model.Page ? "active" : "")"><a class="page-link" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-maHang="@Model.MaHang" asp-route-maNhaCungCap="@Model.MaNhaCungCap" asp-route-maLoaiHang="@Model.MaLoaiHang" asp-route-maDonViTinh="@Model.MaDonViTinh" asp-route-giaTu="@Model.GiaTu" asp-route-giaDen="@Model.GiaDen" asp-route-coCungUng="@Model.CoCungUng">@p</a></li> }</ul></nav></div>
