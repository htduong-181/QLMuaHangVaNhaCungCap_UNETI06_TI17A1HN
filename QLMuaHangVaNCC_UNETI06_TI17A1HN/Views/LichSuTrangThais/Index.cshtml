@model IEnumerable<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.LichSuTrangThai>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <div class="dropdown d-inline-block mb-3"><button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-circle me-1"></i> Thêm / Tạo mới</button><div class="dropdown-menu dropdown-menu-end"><a asp-action="Create">Create New</a></div></div>
</p>
<table id="tableLichSuTrangThai" class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LoaiDoiTuong)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.MaDoiTuong)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrangThaiCu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TrangThaiMoi)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NguoiThucHien)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ThoiGian)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.GhiChu)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NguoiThucHienNavigation)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.LoaiDoiTuong)
            </td>
            <td>
                @Html.DisplayFor(model => item.MaDoiTuong)
            </td>
            <td>
                @Html.DisplayFor(model => item.TrangThaiCu)
            </td>
            <td>
                @Html.DisplayFor(model => item.TrangThaiMoi)
            </td>
            <td>
                @Html.DisplayFor(model => item.NguoiThucHien)
            </td>
            <td>
                @Html.DisplayFor(model => item.ThoiGian)
            </td>
            <td>
                @Html.DisplayFor(model => item.GhiChu)
            </td>
            <td>
                @Html.DisplayFor(model => item.NguoiThucHienNavigation)
            </td>
            <td class="text-nowrap"><div class="dropdown d-inline-block"><button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false"><i class="bi bi-three-dots-vertical me-1"></i>Thao tác</button><div class="dropdown-menu dropdown-menu-end"><a class="dropdown-item" asp-action="Edit" asp-route-id="@item.Id">Sửa</a>
                <a class="dropdown-item" asp-action="Details" asp-route-id="@item.Id">Chi tiết</a>
                <a class="dropdown-item text-danger" asp-action="Delete" asp-route-id="@item.Id">Xóa</a></div></div></td>
        </tr>
}
    </tbody>
</table>
<!-- Vị trí hiển thị nút phân trang -->
<div id="paginationLichSuTrangThai"></div>

<!-- Nhúng JavaScript dùng chung -->
<script src="~/js/pagination.js" asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        initPagination({
            table: "#tableLichSuTrangThai",
            pagination: "#paginationLichSuTrangThai",
            pageSize: 5
        });
    });
</script>