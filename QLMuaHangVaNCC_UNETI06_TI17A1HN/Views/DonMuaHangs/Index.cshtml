@model IEnumerable<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.DonMuaHang>
@{
    ViewData["Title"] = "Đơn mua hàng";
    var danhSach = Model?.ToList() ?? new List<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.DonMuaHang>();
    int trang = (int)ViewBag.Page;
    int tongTrang = (int)ViewBag.TotalPages;
    var tongTien = (decimal)ViewBag.TongTien;
    var cacThe = new List<(string Ten, string GiaTri)>
    {
        ("Tổng đơn", ((int)ViewBag.TongDon).ToString()),
        ("Nháp", ((int)ViewBag.SoNhap).ToString()),
        ("Đã đặt hàng", ((int)ViewBag.SoDaDat).ToString()),
        ("Giao một phần", ((int)ViewBag.SoGiaoMotPhan).ToString()),
        ("Đã giao đủ", ((int)ViewBag.SoDaGiaoDu).ToString())
    };
}

<div class="container-fluid py-4">

    @if (TempData["Loi"] != null)
    {
        <div class="alert alert-danger">@TempData["Loi"]</div>
    }
    @if (TempData["ThanhCong"] != null)
    {
        <div class="alert alert-success">@TempData["ThanhCong"]</div>
    }

    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <div class="d-flex align-items-center gap-2">
                <i class="bi bi-cart-check text-primary fs-2"></i>
                <h2 class="fw-bold mb-0">Đơn mua hàng</h2>
            </div>
            <p class="text-muted mb-0 mt-1">Quản lý các đơn mua hàng từ yêu cầu đã được duyệt</p>
        </div>
        <a asp-action="ChonYeuCau" class="btn btn-primary">
            <i class="bi bi-plus-lg me-1"></i>
            Tạo đơn mua
        </a>
    </div>

    <div class="row g-3 mb-4">
        @foreach (var the in cacThe)
        {
            <div class="col-6 col-md-3 col-xl">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="text-muted small mb-1">@the.Ten</div>
                        <div class="fs-3 fw-bold">@the.GiaTri</div>
                    </div>
                </div>
            </div>
        }
        <div class="col-12 col-md-6 col-xl">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <div class="text-muted small mb-1">Tổng tiền</div>
                    <div class="fs-4 fw-bold text-primary">@tongTien.ToString("N0") đ</div>
                </div>
            </div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">

            <form asp-action="Index" method="get" class="row g-2 mb-4">
                <div class="col-md-5">
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" value="@ViewBag.Search" class="form-control"
                               placeholder="Tìm theo mã đơn hoặc nhà cung cấp..." />
                    </div>
                </div>
                <div class="col-md-3">
                    <select name="trangThai" class="form-select">
                        <option value="">Tất cả trạng thái</option>
                        <option value="Nhap" selected="@(ViewBag.TrangThai == "Nhap")">Nháp</option>
                        <option value="DaDat" selected="@(ViewBag.TrangThai == "DaDat")">Đã đặt hàng</option>
                        <option value="GiaoMotPhan" selected="@(ViewBag.TrangThai == "GiaoMotPhan")">Giao một phần</option>
                        <option value="DaGiaoDu" selected="@(ViewBag.TrangThai == "DaGiaoDu")">Đã giao đủ</option>
                        <option value="HoanThanh" selected="@(ViewBag.TrangThai == "HoanThanh")">Hoàn thành</option>
                        <option value="DaHuy" selected="@(ViewBag.TrangThai == "DaHuy")">Đã hủy</option>
                    </select>
                </div>
                <div class="col-md-auto">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-1"></i>
                        Lọc
                    </button>
                </div>
                <div class="col-md-auto">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-clockwise me-1"></i>
                        Đặt lại
                    </a>
                </div>
            </form>

            @if (!danhSach.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-cart-x fs-1 text-muted"></i>
                    <h5 class="mt-3">Chưa có đơn mua hàng</h5>
                    <p class="text-muted mb-0">Chưa tìm thấy đơn mua hàng phù hợp.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Mã đơn</th>
                                <th>Yêu cầu</th>
                                <th>Nhà cung cấp</th>
                                <th>Ngày đặt</th>
                                <th>Ngày giao dự kiến</th>
                                <th>Người lập</th>
                                <th class="text-end">Tổng tiền</th>
                                <th class="text-center">Trạng thái</th>
                                <th class="text-end">Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in danhSach)
                            {
                                var badgeClass = item.TrangThai switch
                                {
                                    "Nhap" => "bg-secondary",
                                    "DaDat" => "bg-primary",
                                    "GiaoMotPhan" => "bg-warning text-dark",
                                    "DaGiaoDu" => "bg-success",
                                    "HoanThanh" => "bg-success",
                                    "DaHuy" => "bg-danger",
                                    _ => "bg-secondary"
                                };
                                var trangThaiText = item.TrangThai switch
                                {
                                    "Nhap" => "Nháp",
                                    "DaDat" => "Đã đặt hàng",
                                    "GiaoMotPhan" => "Giao một phần",
                                    "DaGiaoDu" => "Đã giao đủ",
                                    "HoanThanh" => "Hoàn thành",
                                    "DaHuy" => "Đã hủy",
                                    _ => item.TrangThai
                                };
                                <tr>
                                    <td><span class="fw-bold text-primary">#@item.MaDonMua</span></td>
                                    <td><span class="fw-semibold">#@item.MaYeuCau</span></td>
                                    <td>@(item.NhaCungCap?.TenNhaCungCap ?? "—")</td>
                                    <td>@item.NgayDat.ToString("dd/MM/yyyy")</td>
                                    <td>@(item.NgayGiaoDuKien.HasValue ? item.NgayGiaoDuKien.Value.ToString("dd/MM/yyyy") : "—")</td>
                                    <td>@(item.NguoiLapNavigation?.HoTen ?? "—")</td>
                                    <td class="text-end fw-semibold">@item.TongTien.ToString("N0") đ</td>
                                    <td class="text-center"><span class="badge @badgeClass">@trangThaiText</span></td>
                                    <td class="text-end">
                                        <div class="btn-group">
                                            <a asp-action="Details" asp-route-madonmua="@item.MaDonMua"
                                               class="btn btn-sm btn-outline-primary" title="Chi tiết">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (item.TrangThai != "DaHuy" && item.TrangThai != "HoanThanh")
                                            {
                                                <a asp-action="Edit" asp-route-madonmua="@item.MaDonMua"
                                                   class="btn btn-sm btn-outline-secondary" title="Sửa">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                            }
                                            @if (item.TrangThai == "DaDat" || item.TrangThai == "GiaoMotPhan")
                                            {
                                                <a asp-controller="LanGiaoHangs" asp-action="Create"
                                                   asp-route-maDonMua="@item.MaDonMua"
                                                   class="btn btn-sm btn-outline-success" title="Tạo lần giao">
                                                    <i class="bi bi-truck"></i>
                                                </a>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                @if (tongTrang > 1)
                {
                    <div class="d-flex justify-content-center align-items-center gap-3 mt-3">
                        @if (trang > 1)
                        {
                            <a class="btn btn-outline-primary" asp-action="Index" asp-route-search="@ViewBag.Search"
                               asp-route-trangThai="@ViewBag.TrangThai" asp-route-page="@(trang - 1)">Trước</a>
                        }
                        <span>Trang @trang / @tongTrang</span>
                        @if (trang < tongTrang)
                        {
                            <a class="btn btn-outline-primary" asp-action="Index" asp-route-search="@ViewBag.Search"
                               asp-route-trangThai="@ViewBag.TrangThai" asp-route-page="@(trang + 1)">Sau</a>
                        }
                    </div>
                }
            }

        </div>
    </div>

</div>
