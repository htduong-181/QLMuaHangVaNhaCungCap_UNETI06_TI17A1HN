@using QLMuaHangVaNCC_UNETI06_TI17A1HN.Models
@model DonMuaHang
@{
    ViewData["Title"] = "Sửa đơn mua #" + Model.MaDonMua;
    var choDoiNcc = (bool)ViewBag.ChoDoiNcc;
    var dsNcc = (IEnumerable<NhaCungCap>)ViewBag.NhaCungCaps;
    var nccHienTai = dsNcc.FirstOrDefault(x => x.MaNhaCungCap == Model.MaNhaCungCap);
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Sửa đơn mua #@Model.MaDonMua</h1>
    <a asp-action="Details" asp-route-madonmua="@Model.MaDonMua" class="btn btn-secondary">Quay lại</a>
</div>

@if (!choDoiNcc)
{
    <div class="alert alert-info">
        Đơn đã có lần giao hàng hoặc không còn ở trạng thái đặt hàng, nên không đổi được nhà cung cấp
        (để không làm mất lịch sử giao nhận).
    </div>
}

<form asp-action="Edit" asp-route-madonmua="@Model.MaDonMua" method="post">
    <div asp-validation-summary="All" class="text-danger mb-3"></div>

    <div class="card shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Nhà cung cấp</label>
                    @if (choDoiNcc)
                    {
                        <select name="maNhaCungCap" class="form-select">
                            @foreach (var n in dsNcc)
                            {
                                <option value="@n.MaNhaCungCap" selected="@(n.MaNhaCungCap == Model.MaNhaCungCap)">@n.TenNhaCungCap</option>
                            }
                        </select>
                    }
                    else
                    {
                        <input type="hidden" name="maNhaCungCap" value="@Model.MaNhaCungCap" />
                        <input class="form-control" value="@nccHienTai?.TenNhaCungCap" disabled />
                    }
                </div>
                <div class="col-md-3">
                    <label class="form-label">Ngày giao dự kiến</label>
                    <input type="date" name="ngayGiaoDuKien" class="form-control"
                           value="@(Model.NgayGiaoDuKien.HasValue ? Model.NgayGiaoDuKien.Value.ToString("yyyy-MM-dd") : "")" />
                </div>
                <div class="col-md-3">
                    <label class="form-label">Tổng tiền</label>
                    <input class="form-control" value="@($"{Model.TongTien:N0}") đ" disabled />
                </div>
                <div class="col-12">
                    <label class="form-label">Ghi chú</label>
                    <input name="ghiChu" class="form-control" value="@Model.GhiChu" />
                </div>
            </div>
        </div>
    </div>

    <p class="text-muted small">
        Số lượng và đơn giá không sửa tại đây. Muốn đổi, hủy đơn (nếu chưa giao hàng) rồi lập đơn mới từ yêu cầu.
    </p>

    <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
    <a asp-action="Details" asp-route-madonmua="@Model.MaDonMua" class="btn btn-secondary">Hủy</a>
</form>