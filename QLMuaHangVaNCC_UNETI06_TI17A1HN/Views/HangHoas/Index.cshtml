@model QLMuaHangVaNCC_UNETI06_TI17A1HN.ViewModels.PagedListVm<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.HangHoa>
@{ ViewData["Title"] = "Hàng hóa"; }

<h2 class="mb-3">Hàng hóa</h2>

@if (TempData["Success"] != null) { <div class="alert alert-success">@TempData["Success"]</div> }
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }

<div class="dropdown d-inline-block mb-3"><button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-circle me-1"></i> Thêm / Tạo mới</button><div class="dropdown-menu dropdown-menu-end"><a asp-action="Create" class="dropdown-item"><i class="bi bi-plus-circle"></i> Thêm mới</a></div></div>

<form method="get" asp-action="Index" class="card card-body mb-3">
    <div class="row g-2">
        <div class="col-md-3"><input class="form-control" type="search" name="search" value="@Model.Search" placeholder="Tìm tên, mã và thông tin liên quan" /></div>
        <div class="col-md-2">
            <select name="maLoaiHang" class="form-select">
                <option value="">Tất cả loại hàng</option>
                @foreach (var x in Model.LoaiHangs) { <option value="@x.MaLoaiHang" selected="@(Model.MaLoaiHang == x.MaLoaiHang)">@x.TenLoaiHang</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select name="maDonViTinh" class="form-select">
                <option value="">Tất cả đơn vị tính</option>
                @foreach (var x in Model.DonViTinhs) { <option value="@x.MaDonViTinh" selected="@(Model.MaDonViTinh == x.MaDonViTinh)">@x.TenDonViTinh</option> }
            </select>
        </div>
        <div class="col-md-2"><input class="form-control" type="number" min="0" step="0.01" name="giaTu" value="@Model.GiaTu" placeholder="Giá từ" /></div>
        <div class="col-md-2"><input class="form-control" type="number" min="0" step="0.01" name="giaDen" value="@Model.GiaDen" placeholder="Giá đến" /></div>
        <div class="col-md-3">
            <select name="maNhaCungCap" class="form-select">
                <option value="">Chọn NCC để lọc cung ứng</option>
                @foreach (var x in Model.NhaCungCaps) { <option value="@x.MaNhaCungCap" selected="@(Model.MaNhaCungCap == x.MaNhaCungCap)">@x.TenNhaCungCap</option> }
            </select>
        </div>
        <div class="col-md-2">
            <select name="coCungUng" class="form-select">
                <option value="">Cung ứng: Tất cả</option>
                <option value="true" selected="@(Model.CoCungUng == true)">Có cung ứng</option>
                <option value="false" selected="@(Model.CoCungUng == false)">Không cung ứng</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="status" class="form-select">
                <option value="">Mọi trạng thái</option>
                <option value="true" selected="@(Model.Status == true)">Hoạt động</option>
                <option value="false" selected="@(Model.Status == false)">Ngừng hoạt động</option>
            </select>
        </div>
        <div class="col-md-2">
            <select name="sort" class="form-select">
                <option value="">Sắp xếp mặc định</option>
                <option value="name_asc" selected="@(Model.Sort == "name_asc")">Tên A-Z</option>
                <option value="name_desc" selected="@(Model.Sort == "name_desc")">Tên Z-A</option>
                <option value="price_asc" selected="@(Model.Sort == "price_asc")">Giá tăng</option>
                <option value="price_desc" selected="@(Model.Sort == "price_desc")">Giá giảm</option>
            </select>
        </div>
        <div class="col-md-auto">
            <button class="btn btn-primary" type="submit">Lọc / Tìm</button>
            <a asp-action="Index" class="btn btn-outline-secondary">Xóa lọc</a>
        </div>
    </div>
</form>

<div class="table-responsive">
    <table id="tableHangHoa" class="table table-hover table-bordered align-middle">
        <thead class="table-light">
            <tr><th>Mã</th><th>Tên hàng</th><th>Loại hàng</th><th>Đơn vị tính</th><th>Giá</th><th>Trạng thái</th><th>Thao tác</th></tr>
        </thead>
        <tbody>
            @foreach (var item in Model.Items) {
                <tr>
                    <td>@item.MaHang</td>
                    <td>@item.TenHang</td>
                    <td>@item.LoaiHang.TenLoaiHang</td>
                    <td>@item.DonViTinh.TenDonViTinh</td>
                    <td>@item.GiaThamKhao</td>
                    <td><span class="badge @(item.TrangThai ? "bg-success" : "bg-secondary")">@(item.TrangThai ? "Hoạt động" : "Ngừng")</span></td>
                    <td class="text-nowrap"><div class="dropdown d-inline-block"><button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false"><i class="bi bi-three-dots-vertical me-1"></i>Thao tác</button><div class="dropdown-menu dropdown-menu-end"><a asp-action="Details" asp-route-id="@item.MaHang" class="dropdown-item">Chi tiết</a>
                        <a asp-controller="ThongKe" asp-action="LichSuHangHoa" asp-route-id="@item.MaHang" class="dropdown-item"><i class="bi bi-clock-history me-1"></i>Lịch sử mua hàng</a>
                        <a asp-action="Edit" asp-route-id="@item.MaHang" class="dropdown-item">Sửa</a>
                        <form method="post" asp-action="ChangeStatus" asp-route-id="@item.MaHang">
                            <button type="submit" class="dropdown-item">Đổi trạng thái</button>
                        </form>
                        <a asp-action="Delete" asp-route-id="@item.MaHang" class="dropdown-item">Xóa</a></div></div></td>
                </tr>
            }
            @if (!Model.Items.Any()) {
                <tr><td colspan="7" class="text-center text-muted">Không có dữ liệu phù hợp</td></tr>
            }
        </tbody>
    </table>
</div>

@{
    int maxPagesToShow = 5;
    int startPage = Math.Max(1, Model.Page - maxPagesToShow / 2);
    int endPage = Math.Min(Model.TotalPages, startPage + maxPagesToShow - 1);
    if (endPage - startPage + 1 < maxPagesToShow) {
        startPage = Math.Max(1, endPage - maxPagesToShow + 1);
    }
}

<div class="d-flex justify-content-center mt-3">
    <nav>
        <ul class="pagination mb-0 gap-1">
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link rounded" asp-action="Index" asp-route-page="1" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-maHang="@Model.MaHang" asp-route-maNhaCungCap="@Model.MaNhaCungCap" asp-route-maLoaiHang="@Model.MaLoaiHang" asp-route-maDonViTinh="@Model.MaDonViTinh" asp-route-giaTu="@Model.GiaTu" asp-route-giaDen="@Model.GiaDen" asp-route-coCungUng="@Model.CoCungUng">«</a>
            </li>
            <li class="page-item @(Model.Page == 1 ? "disabled" : "")">
                <a class="page-link rounded" asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-maHang="@Model.MaHang" asp-route-maNhaCungCap="@Model.MaNhaCungCap" asp-route-maLoaiHang="@Model.MaLoaiHang" asp-route-maDonViTinh="@Model.MaDonViTinh" asp-route-giaTu="@Model.GiaTu" asp-route-giaDen="@Model.GiaDen" asp-route-coCungUng="@Model.CoCungUng">‹</a>
            </li>

            @for (int p = startPage; p <= endPage; p++) {
                <li class="page-item @(p == Model.Page ? "active" : "")">
                    <a class="page-link rounded" asp-action="Index" asp-route-page="@p" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-maHang="@Model.MaHang" asp-route-maNhaCungCap="@Model.MaNhaCungCap" asp-route-maLoaiHang="@Model.MaLoaiHang" asp-route-maDonViTinh="@Model.MaDonViTinh" asp-route-giaTu="@Model.GiaTu" asp-route-giaDen="@Model.GiaDen" asp-route-coCungUng="@Model.CoCungUng">@p</a>
                </li>
            }

            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link rounded" asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-maHang="@Model.MaHang" asp-route-maNhaCungCap="@Model.MaNhaCungCap" asp-route-maLoaiHang="@Model.MaLoaiHang" asp-route-maDonViTinh="@Model.MaDonViTinh" asp-route-giaTu="@Model.GiaTu" asp-route-giaDen="@Model.GiaDen" asp-route-coCungUng="@Model.CoCungUng">›</a>
            </li>
            <li class="page-item @(Model.Page == Model.TotalPages ? "disabled" : "")">
                <a class="page-link rounded" asp-action="Index" asp-route-page="@Model.TotalPages" asp-route-search="@Model.Search" asp-route-status="@Model.Status" asp-route-sort="@Model.Sort" asp-route-maHang="@Model.MaHang" asp-route-maNhaCungCap="@Model.MaNhaCungCap" asp-route-maLoaiHang="@Model.MaLoaiHang" asp-route-maDonViTinh="@Model.MaDonViTinh" asp-route-giaTu="@Model.GiaTu" asp-route-giaDen="@Model.GiaDen" asp-route-coCungUng="@Model.CoCungUng">»</a>
            </li>
        </ul>
    </nav>
</div>