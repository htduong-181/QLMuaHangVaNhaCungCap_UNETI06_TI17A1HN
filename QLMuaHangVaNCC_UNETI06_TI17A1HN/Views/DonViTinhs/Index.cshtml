@model IEnumerable<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.DonViTinh>

@{
    ViewData["Title"] = "Đơn vị tính";
}

<h3>Quản lý đơn vị tính</h3>

@if (TempData["ThongBao"] != null)
{
    <div class="alert alert-success">@TempData["ThongBao"]</div>
}

@if (TempData["Loi"] != null)
{
    <div class="alert alert-danger">@TempData["Loi"]</div>
}

<div class="d-flex justify-content-between mb-3">
    <form method="get" class="d-flex gap-2">
        <input name="tuKhoa"
               value="@ViewBag.TuKhoa"
               class="form-control"
               placeholder="Tên đơn vị tính" />

        <button class="btn btn-outline-primary">Tìm</button>
    </form>

    <div class="dropdown d-inline-block mb-3"><button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-circle me-1"></i> Thêm / Tạo mới</button><div class="dropdown-menu dropdown-menu-end"><a asp-action="Create" class="dropdown-item">
        + Thêm đơn vị tính
    </a></div></div>
</div>

<table id="tableDonViTinh" class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>@Html.DisplayNameFor(m => m.TenDonViTinh)</th>
            <th>@Html.DisplayNameFor(m => m.MoTa)</th>
            <th>Trạng thái</th>
            <th>Thao tác</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var l in Model)
        {
            <tr>
                <td>@l.TenDonViTinh</td>
                <td>@l.MoTa</td>
                <td>
                    @if (l.TrangThai)
                    {
                        <span class="badge bg-success">Hoạt động</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Ngừng</span>
                    }
                </td>
                <td class="text-nowrap"><div class="dropdown d-inline-block"><button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false"><i class="bi bi-three-dots-vertical me-1"></i>Thao tác</button><div class="dropdown-menu dropdown-menu-end">
                        <a asp-action="Edit"
                           asp-route-id="@l.MaDonViTinh"
                           class="dropdown-item">
                            Sửa
                        </a>

                        <form asp-action="DoiTrangThai"
                              asp-route-id="@l.MaDonViTinh"
                              method="post">
                            <button class="dropdown-item">
                                @(l.TrangThai ? "Ngừng" : "Kích hoạt")
                            </button>
                        </form>

                        <form asp-action="Delete"
                              asp-route-id="@l.MaDonViTinh"
                              method="post"
                              onsubmit="return confirm('Xóa đơn vị tính này?')">
                            <button class="dropdown-item">
                                Xóa
                            </button>
                        </form>
                    </div></div></td>
            </tr>
        }
    </tbody>
</table>

<!-- Vị trí hiển thị nút phân trang -->
<div id="paginationDonViTinh"></div>

<!-- Nhúng JavaScript dùng chung -->
<script src="~/js/pagination.js" asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        initPagination({
            table: "#tableDonViTinh",
            pagination: "#paginationDonViTinh",
            pageSize: 5
        });
    });
</script>
