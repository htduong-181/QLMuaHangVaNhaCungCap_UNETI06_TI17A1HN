@model IEnumerable<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.ChiTietDonMua>

@{
    ViewData["Title"] = "Chi tiết đơn mua";
    var daNhan = ViewBag.DaNhan as Dictionary<int, int> ?? new Dictionary<int, int>();
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Chi tiết đơn mua</h2>
            <p class="text-muted mb-0">Theo dõi số lượng đặt, đã nhận và còn lại</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Mã CT</th>
                            <th>Đơn mua</th>
                            <th>Hàng hóa</th>
                            <th class="text-end">SL đặt</th>
                            <th class="text-end">Đã nhận</th>
                            <th class="text-end">Còn lại</th>
                            <th class="text-end">Đơn giá</th>
                            <th class="text-end">Thành tiền</th>
                            <th>Tiến độ</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            var nhan = daNhan.GetValueOrDefault(item.MaChiTietDon);
                            var conLai = Math.Max(0, item.SoLuongDat - nhan);
                            var phanTram = item.SoLuongDat > 0
                                ? Math.Min(100, nhan * 100.0 / item.SoLuongDat)
                                : 0;

                            <tr>
                                <td>@item.MaChiTietDon</td>
                                <td>#@item.MaDonMua</td>
                                <td>@item.HangHoa?.TenHang</td>
                                <td class="text-end">@item.SoLuongDat</td>
                                <td class="text-end">@nhan</td>
                                <td class="text-end">@conLai</td>
                                <td class="text-end">@item.DonGiaMua.ToString("N0")</td>
                                <td class="text-end fw-semibold">@item.ThanhTien.ToString("N0")</td>
                                <td style="min-width:150px">
                                    <div class="progress" style="height:8px">
                                        <div class="progress-bar" style="width:@phanTram%"></div>
                                    </div>
                                    <small class="text-muted">@phanTram.ToString("0")%</small>
                                </td>
                                <td class="text-nowrap">
                                    <a asp-action="Details" asp-route-id="@item.MaChiTietDon" class="btn btn-sm btn-outline-primary">Xem</a>
                                    <a asp-action="Edit" asp-route-id="@item.MaChiTietDon" class="btn btn-sm btn-outline-warning">Sửa</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>