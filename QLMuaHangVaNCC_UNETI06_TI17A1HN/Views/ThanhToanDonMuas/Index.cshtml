@* Họ và tên: Trương Huy Đồng *@
@* Mã sinh viên: 23103100036 *@
@* Nội dung thực hiện: Module 5 - Giao diện danh sách thanh toán, lọc theo trạng thái, theo dõi số tiền còn lại *@

@model IEnumerable<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.ThanhToanDonMua>
@{
    ViewData["Title"] = "Quản lý Thanh toán Đơn mua";
    // Ép kiểu danh sách tổng hợp công nợ từ ViewBag
    var danhSachDon = ViewBag.DanhSachDonThanhToan as List<QLMuaHangVaNCC_UNETI06_TI17A1HN.Controllers.DonMuaThanhToanVM>;
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h3 class="text-primary fw-bold">Quản Lý Thanh Toán & Công Nợ</h3>
        <a asp-action="Create" class="btn btn-success fw-bold">+ Ghi nhận thanh toán mới</a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Thành công!</strong> @TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- BỘ LỌC TÌM KIẾM -->
    <form method="get" class="card card-body bg-light mb-4 shadow-sm border-0">
        <div class="row g-2">
            <div class="col-md-3">
                <label class="form-label fw-bold">Từ khóa (Mã đơn / NCC / Người TT)</label>
                <input type="text" name="searchString" value="@ViewBag.SearchString" class="form-control" placeholder="Nhập từ khóa..." />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Phương thức</label>
                <select name="phuongThuc" class="form-select">
                    <option value="">-- Tất cả --</option>
                    <option value="ChuyenKhoan" selected="@(ViewBag.PhuongThuc == "ChuyenKhoan")">Chuyển khoản</option>
                    <option value="TienMat" selected="@(ViewBag.PhuongThuc == "TienMat")">Tiền mặt</option>
                    <option value="UyNhiemChi" selected="@(ViewBag.PhuongThuc == "UyNhiemChi")">Ủy nhiệm chi</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Trạng thái công nợ</label>
                <select name="trangThaiTT" class="form-select">
                    <option value="">-- Tất cả --</option>
                    <option value="Chưa thanh toán" selected="@(ViewBag.TrangThaiTT == "Chưa thanh toán")">Chưa thanh toán</option>
                    <option value="Thanh toán một phần" selected="@(ViewBag.TrangThaiTT == "Thanh toán một phần")">Thanh toán một phần</option>
                    <option value="Đã thanh toán" selected="@(ViewBag.TrangThaiTT == "Đã thanh toán")">Đã thanh toán</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Từ ngày</label>
                <input type="date" name="tuNgay" value="@ViewBag.TuNgay" class="form-control" />
            </div>
            <div class="col-md-2">
                <label class="form-label fw-bold">Đến ngày</label>
                <input type="date" name="denNgay" value="@ViewBag.DenNgay" class="form-control" />
            </div>
            <div class="col-md-1 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100">Lọc</button>
            </div>
        </div>
    </form>

    <!-- BẢNG 1: TỔNG HỢP TRẠNG THÁI THANH TOÁN THEO ĐƠN MUA -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-dark text-white fw-bold">
            1. Tình Trạng Thanh Toán & Công Nợ Theo Đơn Mua
        </div>
        <div class="table-responsive">
            <table class="table table-bordered table-hover mb-0">
                <thead class="table-secondary align-middle text-center">
                    <tr>
                        <th>Mã đơn</th>
                        <th>Nhà cung cấp</th>
                        <th>Ngày đặt</th>
                        <th>Tổng tiền đơn</th>
                        <th>Đã thanh toán</th>
                        <th>Còn lại (Nợ)</th>
                        <th>Trạng thái</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody class="align-middle">
                    @if (danhSachDon != null && danhSachDon.Any())
                    {
                        foreach (var d in danhSachDon)
                        {
                            <tr>
                                <td class="text-center">
                                    <a asp-controller="DonMuaHangs" asp-action="Details" asp-route-id="@d.MaDonMua" class="fw-bold">
                                        #@d.MaDonMua
                                    </a>
                                </td>
                                <td>@d.TenNhaCungCap</td>
                                <td class="text-center">@d.NgayDat.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-bold">@d.TongTienDon.ToString("N0") đ</td>
                                <td class="text-end text-success">@d.TongDaThanhToan.ToString("N0") đ</td>
                                <td class="text-end text-danger fw-bold">@d.SoTienConLai.ToString("N0") đ</td>
                                <td class="text-center">
                                    @if (d.TrangThaiThanhToan == "Đã thanh toán")
                                    {
                                        <span class="badge bg-success">Đã thanh toán</span>
                                    }
                                    else if (d.TrangThaiThanhToan == "Thanh toán một phần")
                                    {
                                        <span class="badge bg-warning text-dark">Thanh toán một phần</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Chưa thanh toán</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (d.SoTienConLai > 0)
                                    {
                                        <a asp-action="Create" asp-route-maDonMua="@d.MaDonMua" class="btn btn-sm btn-primary">Thanh toán</a>
                                    }
                                    else
                                    {
                                        <span class="text-muted small"><i class="bi bi-check-circle-fill"></i> Đã tất toán</span>
                                    }
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center text-muted py-3">Không có đơn mua nào phù hợp với điều kiện lọc.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- BẢNG 2: LỊCH SỬ CÁC LẦN THANH TOÁN CHI TIẾT -->
    <div class="card shadow-sm">
        <div class="card-header bg-info text-white fw-bold">
            2. Nhật Ký Chi Tiết Các Lần Đã Thanh Toán
        </div>
        <div class="table-responsive">
            <table class="table table-striped mb-0">
                <thead class="align-middle text-center">
                    <tr>
                        <th>Mã TT</th>
                        <th>Đơn mua</th>
                        <th>Nhà cung cấp</th>
                        <th>Ngày thanh toán</th>
                        <th>Số tiền thanh toán</th>
                        <th>Phương thức</th>
                        <th>Người thực hiện</th>
                        <th>Ghi chú</th>
                        <th>Chi tiết</th>
                    </tr>
                </thead>
                <tbody class="align-middle">
                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            <tr>
                                <td class="text-center">#@item.MaThanhToan</td>
                                <td class="text-center fw-bold">#@item.MaDonMua</td>
                                <td>@item.DonMuaHang?.NhaCungCap?.TenNhaCungCap</td>
                                <td class="text-center">@item.NgayThanhToan.ToString("dd/MM/yyyy")</td>
                                <td class="text-end fw-bold text-success">@item.SoTienThanhToan.ToString("N0") đ</td>
                                <td class="text-center">
                                    @(item.PhuongThuc == "ChuyenKhoan" ? "Chuyển khoản" :
                                      item.PhuongThuc == "TienMat" ? "Tiền mặt" :
                                      item.PhuongThuc == "UyNhiemChi" ? "Ủy nhiệm chi" : item.PhuongThuc)
                                </td>
                                <td>@(item.NguoiThucHienNavigation?.HoTen ?? $"Mã TK: {item.NguoiThucHien}")</td>
                                <td>@item.GhiChu</td>
                                <td class="text-center">
                                    <a asp-action="Details" asp-route-id="@item.MaThanhToan" class="btn btn-sm btn-outline-dark">Xem</a>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center text-muted py-3">Chưa có giao dịch thanh toán nào được ghi nhận.</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
