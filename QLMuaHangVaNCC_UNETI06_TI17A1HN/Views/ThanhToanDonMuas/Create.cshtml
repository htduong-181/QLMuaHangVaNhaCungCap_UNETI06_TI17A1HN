@* Họ và tên: Trương Huy Đồng *@
@* Mã sinh viên: 23103100036 *@
@* Nội dung thực hiện: Module 5 - Form tạo mới bản ghi thanh toán, tự động lấy công nợ từ Dropdown và validate *@

@model QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.ThanhToanDonMua
@{
    ViewData["Title"] = "Ghi nhận thanh toán";
}

<div class="container mt-4 mb-5">
    <div class="card shadow border-0 col-md-8 mx-auto">
        <div class="card-header bg-primary text-white">
            <h4 class="mb-0 fw-bold"><i class="bi bi-wallet2"></i> Lập Phiếu Thanh Toán Đơn Mua</h4>
        </div>
        <div class="card-body bg-light">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <!-- CHỌN ĐƠN MUA HÀNG -->
                <div class="mb-3">
                    <label asp-for="MaDonMua" class="form-label fw-bold text-primary"></label>
                    <select asp-for="MaDonMua" class="form-select form-select-lg shadow-sm" asp-items="ViewBag.MaDonMua" onchange="this.form.submit()"></select>
                    <span asp-validation-for="MaDonMua" class="text-danger"></span>
                    <small class="text-muted d-block mt-1">Hệ thống chỉ hiển thị những đơn chưa thanh toán xong (Không ở trạng thái Nháp/Hủy).</small>
                </div>

                <!-- KHUNG HIỂN THỊ SỐ TIỀN CÒN LẠI (JS TỰ ĐỘNG BẬT LÊN) -->
                <div id="alertMaxTien" class="alert alert-warning border-warning border-2 py-2 fs-5 shadow-sm" style="display:none;">
                    <i class="bi bi-info-circle-fill"></i> Số tiền công nợ tối đa có thể thanh toán:
                    <strong id="textMaxTien" class="text-danger">0 VNĐ</strong>
                </div>

                <div class="row bg-white p-3 border rounded shadow-sm mx-0 mb-3">
                    <div class="col-md-6 mb-3">
                        <label asp-for="NgayThanhToan" class="form-label fw-bold"></label>
                        <input asp-for="NgayThanhToan" type="date" class="form-control" />
                        <span asp-validation-for="NgayThanhToan" class="text-danger"></span>
                    </div>
                    
                    <div class="col-md-6 mb-3">
                        <label asp-for="SoTienThanhToan" class="form-label fw-bold"></label>
                        <div class="input-group">
                            <input asp-for="SoTienThanhToan" id="SoTienThanhToan" type="text" inputmode="numeric" 
                                   class="form-control text-end fw-bold text-success fs-5" 
                                   placeholder="Nhập số tiền..." />
                            <span class="input-group-text fw-bold">VNĐ</span>
                        </div>
                        <span asp-validation-for="SoTienThanhToan" class="text-danger"></span>
                        
                        <!-- CHỖ HIỂN THỊ THÔNG BÁO SỐ TIỀN CÒN THIẾU / BÁO LỖI -->
                        <small id="thongBaoSoTien" class="form-text d-block mt-1 fs-6"></small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="PhuongThuc" class="form-label fw-bold"></label>
                        <select asp-for="PhuongThuc" class="form-select">
                            <option value="ChuyenKhoan">Chuyển khoản ngân hàng</option>
                            <option value="TienMat">Tiền mặt</option>
                            <option value="UyNhiemChi">Ủy nhiệm chi</option>
                        </select>
                        <span asp-validation-for="PhuongThuc" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="NguoiThucHien" class="form-label fw-bold"></label>
                        <select asp-for="NguoiThucHien" class="form-select" asp-items="ViewBag.NguoiThucHien"></select>
                        <span asp-validation-for="NguoiThucHien" class="text-danger"></span>
                    </div>

                    <div class="col-md-12">
                        <label asp-for="GhiChu" class="form-label fw-bold"></label>
                        <textarea asp-for="GhiChu" rows="3" class="form-control" placeholder="Nhập mã giao dịch, số UNC hoặc ghi chú..."></textarea>
                        <span asp-validation-for="GhiChu" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Index" class="btn btn-secondary px-4"><i class="bi bi-arrow-left"></i> Quay lại</a>
                    <button type="submit" id="btnSubmit" class="btn btn-success px-5 fw-bold"><i class="bi bi-save"></i> Xác Nhận Thanh Toán</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <!-- SCRIPT ĐỌC DỮ LIỆU TRỰC TIẾP TỪ DROPDOWN VÀ TÍNH TOÁN -->
    <script>
        $(document).ready(function () {
            var $inputTien = $('#SoTienThanhToan');
            var $thongBao = $('#thongBaoSoTien');
            var $btnSubmit = $('#btnSubmit');
            var $selectDonMua = $('#MaDonMua');

            // 1. Hàm trích xuất công nợ cực xịn từ chữ trong Dropdown
            function getMaxAmount() {
                var selectedText = $selectDonMua.find('option:selected').text();
                // Tìm đoạn "Còn lại: xxx đ" và bóc tách lấy riêng phần số
                if (selectedText && selectedText.indexOf('Còn lại:') !== -1) {
                    var parts = selectedText.split('Còn lại:');
                    var moneyString = parts[1].replace(/[^0-9]/g, ''); // Lọc vứt hết chữ, dấu phẩy, chỉ giữ lại số
                    return parseFloat(moneyString) || 0;
                }
                return 0; 
            }

            function formatCurrency(number) {
                return new Intl.NumberFormat('vi-VN').format(number) + ' VNĐ';
            }

            // 2. Hàm cập nhật lại toàn bộ giao diện
            function updateUI() {
                var maxAmount = getMaxAmount();

                // Hiển thị khung cảnh báo số tiền công nợ màu vàng
                if (maxAmount > 0) {
                    $('#alertMaxTien').show();
                    $('#textMaxTien').text(formatCurrency(maxAmount));
                } else {
                    $('#alertMaxTien').hide();
                }

                // Tính toán tiền nhập
                var currentVal = parseFloat($inputTien.val()) || 0;
                var remaining = maxAmount - currentVal;

                if (currentVal <= 0) {
                    $thongBao.text(''); 
                    $btnSubmit.prop('disabled', false);
                } 
                else if (currentVal > maxAmount) {
                    // Nếu nhập lố số tiền
                    $thongBao.removeClass('text-primary text-success').addClass('text-danger fw-bold');
                    $thongBao.html('<i class="bi bi-x-circle-fill"></i> Vượt quá công nợ ' + formatCurrency(currentVal - maxAmount) + '!');
                    $btnSubmit.prop('disabled', true); 
                } 
                else {
                    // Nếu nhập hợp lệ
                    $thongBao.removeClass('text-danger text-success').addClass('text-primary fw-bold');
                    if (remaining === 0) {
                        $thongBao.removeClass('text-primary').addClass('text-success fw-bold');
                        $thongBao.html('<i class="bi bi-check-circle-fill"></i> Sẽ tất toán hết nợ của đơn này.');
                    } else {
                        $thongBao.html('<i class="bi bi-info-circle-fill"></i> Sau thanh toán còn nợ: ' + formatCurrency(remaining));
                    }
                    $btnSubmit.prop('disabled', false); 
                }
            }

            // 3. Lắng nghe sự kiện mỗi khi người dùng gõ phím
            $inputTien.on('input', function () {
                // Ngăn chặn gõ chữ, ký tự lạ
                this.value = this.value.replace(/[^0-9]/g, '');
                updateUI();
            });

            // 4. Kích hoạt tính toán ngay khi trang vừa tải xong
            updateUI();
        });
    </script>
}   