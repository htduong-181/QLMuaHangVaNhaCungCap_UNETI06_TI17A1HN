@model List<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.TaiKhoan>
@{ ViewData["Title"] = "Quản lý tài khoản"; }

<h3>Quản lý tài khoản</h3>

@if (TempData["ThongBao"] != null) { <div class="alert alert-success">@TempData["ThongBao"]</div> }
@if (TempData["Loi"] != null) { <div class="alert alert-danger">@TempData["Loi"]</div> }

<div class="d-flex justify-content-between mb-3">
    <form method="get" class="d-flex gap-2">
        <input name="tuKhoa" value="@ViewBag.TuKhoa" class="form-control" placeholder="Tên đăng nhập / họ tên" />
        <button class="btn btn-outline-primary">Tìm</button>
    </form>
    <div class="dropdown d-inline-block mb-3"><button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-circle me-1"></i> Thêm / Tạo mới</button><div class="dropdown-menu dropdown-menu-end"><a asp-action="Create" class="dropdown-item">+ Thêm tài khoản</a></div></div>
</div>

<table id="tableTaiKhoan" class="table table-bordered table-hover">
    <thead class="table-light">
        <tr><th>Tên đăng nhập</th><th>Họ tên</th><th>Email</th><th>Vai trò</th><th>Trạng thái</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var t in Model)
    {
        <tr>
            <td>@t.TenDangNhap</td>
            <td>@t.HoTen</td>
            <td>@t.Email</td>
            <td>@t.VaiTro</td>
            <td>
                @if (t.TrangThai) { <span class="badge bg-success">Hoạt động</span> }
                else { <span class="badge bg-secondary">Đã khóa</span> }
            </td>
            <td class="text-nowrap"><div class="dropdown d-inline-block"><button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false"><i class="bi bi-three-dots-vertical me-1"></i>Thao tác</button><div class="dropdown-menu dropdown-menu-end"><a asp-action="Edit" asp-route-id="@t.MaTaiKhoan" class="dropdown-item">Sửa</a>
                <form asp-action="DoiTrangThai" asp-route-id="@t.MaTaiKhoan" method="post"
                      onsubmit="return confirm('Đổi trạng thái tài khoản này?')">
                    <button class="dropdown-item">@(t.TrangThai ? "Khóa" : "Mở khóa")</button>
                </form></div></div></td>
        </tr>
    }
    </tbody>
</table>
<!-- Vị trí hiển thị nút phân trang -->
<div id="paginationTaiKhoan"></div>

<!-- Nhúng JavaScript dùng chung -->
<script src="~/js/pagination.js" asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        initPagination({
            table: "#tableTaiKhoan",
            pagination: "#paginationTaiKhoan",
            pageSize: 5
        });
    });
</script>