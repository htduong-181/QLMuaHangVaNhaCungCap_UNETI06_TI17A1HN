   Mã sinh viên: 23103100051
   Nội dung thực hiện: Module 3 - Lập yêu cầu mua hàng. *@
@using QLMuaHangVaNCC_UNETI06_TI17A1HN.ViewModels
@model YeuCauFormViewModel
@{ ViewData["Title"] = "Lập yêu cầu mua hàng"; }

<h2>Lập yêu cầu mua hàng</h2>
<p class="text-muted">Sau khi lưu, yêu cầu ở trạng thái <b>Nháp</b>. Bạn thêm mặt hàng rồi bấm <b>Gửi duyệt</b>.</p>

<form asp-action="Create" method="post">
    @await Html.PartialAsync("_Form", Model)
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Lưu nháp</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
