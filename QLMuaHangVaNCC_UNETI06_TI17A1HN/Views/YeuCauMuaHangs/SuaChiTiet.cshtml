@* Họ và tên: Hoàng Thùy Dương
   Mã sinh viên: 23103100051
   Nội dung thực hiện: Module 3 - Sửa một dòng chi tiết yêu cầu (chỉ đổi số lượng/ghi chú, không đổi mặt hàng). *@
@using QLMuaHangVaNCC_UNETI06_TI17A1HN.ViewModels
@model ChiTietYeuCauFormViewModel
@{ ViewData["Title"] = "Sửa chi tiết yêu cầu"; }

<h2>Sửa chi tiết: @Model.TenHang</h2>

<form asp-action="SuaChiTiet" asp-route-id="@Model.MaChiTietYeuCau" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="MaYeuCau" />
    <input type="hidden" asp-for="MaChiTietYeuCau" />
    <input type="hidden" asp-for="MaHang" />
    <div class="row g-3" style="max-width:600px">
        <div class="col-md-4">
            <label asp-for="SoLuongYeuCau" class="form-label"></label>
            <input asp-for="SoLuongYeuCau" type="number" min="1" class="form-control" />
            <span asp-validation-for="SoLuongYeuCau" class="text-danger"></span>
        </div>
        <div class="col-12">
            <label asp-for="GhiChu" class="form-label"></label>
            <textarea asp-for="GhiChu" class="form-control" rows="2"></textarea>
            <span asp-validation-for="GhiChu" class="text-danger"></span>
        </div>
    </div>
    <div class="mt-3">
        <button type="submit" class="btn btn-primary">Lưu</button>
        <a asp-action="Details" asp-route-id="@Model.MaYeuCau" class="btn btn-outline-secondary">Quay lại</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
