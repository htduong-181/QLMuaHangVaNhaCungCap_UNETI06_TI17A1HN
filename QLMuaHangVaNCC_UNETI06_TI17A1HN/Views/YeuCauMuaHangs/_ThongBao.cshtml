@* Họ và tên: Hoàng Thùy Dương
   Mã sinh viên: 23103100051
   Nội dung thực hiện: Module 3 - Partial hiển thị thông báo thành công / lỗi nghiệp vụ (TempData). *@
@if (TempData["ThongBao"] is string tb)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        @tb
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
@if (TempData["Loi"] is string loi)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        @loi
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Đóng"></button>
    </div>
}
