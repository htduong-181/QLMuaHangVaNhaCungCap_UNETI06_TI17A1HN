@model IEnumerable<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.YeuCauMuaHang>
@using QLMuaHangVaNCC_UNETI06_TI17A1HN.Models
@{ ViewData["Title"] = "Yêu cầu mua hàng"; }

<h3>Yêu cầu mua hàng</h3>

@if (TempData["ThongBao"] != null) { <div class="alert alert-success">@TempData["ThongBao"]</div> }
@if (TempData["Loi"] != null) { <div class="alert alert-danger">@TempData["Loi"]</div> }

<div class="d-flex justify-content-between mb-3">
    <form method="get" class="d-flex gap-2">
        <select name="trangThai" class="form-select" onchange="this.form.submit()">
            <option value="">-- Tất cả trạng thái --</option>
            @foreach (var tt in TrangThaiYeuCau.TatCa)
            {
                <option value="@tt" selected="@(ViewBag.TrangThai == tt)">@TrangThaiYeuCau.NhanTiengViet(tt)</option>
            }
        </select>

        <select name="mucDoUuTien" class="form-select" onchange="this.form.submit()">
            <option value="">-- Tất cả mức độ --</option>
            @foreach (var tt in MucDoUuTien.TatCa)
            {
                <option value="@tt" selected="@(ViewBag.MucDoUuTien == tt)">@MucDoUuTien.NhanTiengViet(tt)</option>
            }
        </select>

        <input type="date"
               name="tuNgay"
               class="form-control"
               value="@ViewBag.TuNgay"
               title="Từ ngày"
               lang="vi" />

        <input type="date"
               name="denNgay"
               class="form-control"
               value="@ViewBag.DenNgay"
               title="Đến ngày"
               lang="vi" />

        <button type="submit" class="btn btn-primary">
            Lọc
        </button>
    </form>
    <div class="dropdown d-inline-block mb-3"><button type="button" class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false"><i class="bi bi-plus-circle me-1"></i> Thêm / Tạo mới</button><div class="dropdown-menu dropdown-menu-end"><a asp-action="Create" class="dropdown-item">+ Tạo yêu cầu</a></div></div>
</div>

<table id="tableYeuCauMuaHang" class="table table-bordered table-hover">
    <thead class="table-light">
        <tr>
            <th>Mã</th><th>Bộ phận</th><th>Người lập</th><th>Ngày yêu cầu</th>
            <th>Ngày cần hàng</th><th>Ưu tiên</th><th>Trạng thái</th><th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var y in Model)
    {
        <tr>
            <td>@y.MaYeuCau</td>
            <td>@y.BoPhanDeNghi.TenBoPhan</td>
            <td>@y.NguoiLapNavigation.HoTen</td>
            <td>@y.NgayYeuCau.ToString("dd/MM/yyyy")</td>
            <td>@y.NgayCanHang.ToString("dd/MM/yyyy")</td>
            <td>@MucDoUuTien.NhanTiengViet(y.MucDoUuTien)</td>
            <td><span class="badge bg-@TrangThaiYeuCau.MauBadge(y.TrangThai)">@TrangThaiYeuCau.NhanTiengViet(y.TrangThai)</span></td>
            <td class="text-nowrap"><div class="dropdown d-inline-block"><button type="button" class="btn btn-sm btn-outline-primary dropdown-toggle" data-bs-toggle="dropdown" data-bs-boundary="viewport" aria-expanded="false"><i class="bi bi-three-dots-vertical me-1"></i>Thao tác</button><div class="dropdown-menu dropdown-menu-end"><a asp-action="Details" asp-route-id="@y.MaYeuCau" class="dropdown-item">Xem</a></div></div></td>
        </tr>
    }
    </tbody>
</table>
<!-- Vị trí hiển thị nút phân trang -->
<div id="paginationYeuCauMuaHang"></div>

<!-- Nhúng JavaScript dùng chung -->
<script src="~/js/pagination.js" asp-append-version="true"></script>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        initPagination({
            table: "#tableYeuCauMuaHang",
            pagination: "#paginationYeuCauMuaHang",
            pageSize: 5
        });
    });
</script>