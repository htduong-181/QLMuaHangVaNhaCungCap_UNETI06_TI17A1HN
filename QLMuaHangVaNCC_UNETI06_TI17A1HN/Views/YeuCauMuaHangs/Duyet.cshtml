@* Họ và tên: Hoàng Thùy Dương
   Mã sinh viên: 23103100051
   Nội dung thực hiện: Module 3 - Màn hình xét duyệt: nhập số lượng duyệt từng mặt hàng (0 <= duyệt <= yêu cầu). *@
@using QLMuaHangVaNCC_UNETI06_TI17A1HN.ViewModels
@model DuyetYeuCauViewModel
@{ ViewData["Title"] = "Xét duyệt " + Model.MaHienThi; }

<h2>Xét duyệt yêu cầu @Model.MaHienThi</h2>
<p><b>Bộ phận:</b> @Model.TenBoPhan<br /><b>Lý do mua:</b> @Model.LyDoMua</p>

<form asp-action="Duyet" asp-route-id="@Model.MaYeuCau" method="post">
    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
    <input type="hidden" asp-for="MaYeuCau" />

    <table class="table table-bordered align-middle" style="max-width:900px">
        <thead class="table-light">
            <tr><th>Hàng hóa</th><th>ĐVT</th><th class="text-end">SL yêu cầu</th><th style="width:180px">SL duyệt</th></tr>
        </thead>
        <tbody>
            @for (var i = 0; i < Model.Dong.Count; i++)
            {
                <tr>
                    <td>
                        @Model.Dong[i].TenHang
                        <input type="hidden" asp-for="Dong[i].MaChiTietYeuCau" />
                    </td>
                    <td>@Model.Dong[i].TenDonViTinh</td>
                    <td class="text-end">@Model.Dong[i].SoLuongYeuCau.ToString("N0")</td>
                    <td>
                        <input asp-for="Dong[i].SoLuongDuyet" type="number" min="0" max="@Model.Dong[i].SoLuongYeuCau" class="form-control" />
                        <span asp-validation-for="Dong[i].SoLuongDuyet" class="text-danger"></span>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <p class="text-muted">Phải có ít nhất một mặt hàng được duyệt với số lượng &gt; 0. Nếu không duyệt mặt hàng nào, hãy quay lại và chọn <b>Từ chối</b>.</p>
    <button type="submit" class="btn btn-success">Xác nhận duyệt</button>
    <a asp-action="Details" asp-route-id="@Model.MaYeuCau" class="btn btn-outline-secondary">Quay lại</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
