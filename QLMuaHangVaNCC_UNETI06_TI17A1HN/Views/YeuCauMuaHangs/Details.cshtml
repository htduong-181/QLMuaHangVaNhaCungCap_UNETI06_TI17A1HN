@model QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.YeuCauMuaHang
@using QLMuaHangVaNCC_UNETI06_TI17A1HN.Models
@{
    ViewData["Title"] = "Chi tiết yêu cầu #" + Model.MaYeuCau;
    var vaiTro = Context.Session.GetString("VaiTro");
    var maTaiKhoan = Context.Session.GetInt32("MaTaiKhoan");
    var laChuHoacAdmin = Model.NguoiLap == maTaiKhoan || vaiTro == "Admin";
    var dangNhapHoacChoDuyet = Model.TrangThai == TrangThaiYeuCau.Nhap || Model.TrangThai == TrangThaiYeuCau.ChoDuyet;
    var duocSuaXoa = laChuHoacAdmin && dangNhapHoacChoDuyet;
    var duocGuiDuyet = duocSuaXoa && Model.TrangThai == TrangThaiYeuCau.Nhap;
    var duocXetDuyet = (vaiTro == "NguoiDuyet" || vaiTro == "Admin") && Model.TrangThai == TrangThaiYeuCau.ChoDuyet;
}

<h3>
    Yêu cầu #@Model.MaYeuCau
    <span class="badge bg-@TrangThaiYeuCau.MauBadge(Model.TrangThai)">@TrangThaiYeuCau.NhanTiengViet(Model.TrangThai)</span>
</h3>

@if (TempData["ThongBao"] != null) { <div class="alert alert-success">@TempData["ThongBao"]</div> }
@if (TempData["Loi"] != null) { <div class="alert alert-danger">@TempData["Loi"]</div> }

<div class="row mb-3">
    <div class="col-md-6">
        <table class="table table-sm table-borderless">
            <tr><th style="width:160px">Bộ phận</th><td>@Model.BoPhanDeNghi.TenBoPhan</td></tr>
            <tr><th>Người lập</th><td>@Model.NguoiLapNavigation.HoTen</td></tr>
            <tr><th>Ngày yêu cầu</th><td>@Model.NgayYeuCau.ToString("dd/MM/yyyy")</td></tr>
            <tr><th>Ngày cần hàng</th><td>@Model.NgayCanHang.ToString("dd/MM/yyyy")</td></tr>
            <tr><th>Mức ưu tiên</th><td>@MucDoUuTien.NhanTiengViet(Model.MucDoUuTien)</td></tr>
            <tr><th>Lý do mua</th><td>@Model.LyDoMua</td></tr>
            @if (Model.NguoiDuyetNavigation != null)
            {
                <tr><th>Người duyệt</th><td>@Model.NguoiDuyetNavigation.HoTen</td></tr>
                <tr><th>Ngày duyệt</th><td>@Model.NgayDuyet?.ToString("dd/MM/yyyy HH:mm")</td></tr>
            }
            @if (!string.IsNullOrEmpty(Model.LyDoTuChoiHuy))
            {
                <tr><th>Lý do từ chối/hủy</th><td class="text-danger">@Model.LyDoTuChoiHuy</td></tr>
            }
        </table>
    </div>
</div>

<div class="d-flex gap-2 mb-3">
    <a asp-action="Index" class="btn btn-secondary">Quay lại</a>

    @if (duocSuaXoa)
    {
        <a asp-action="Edit" asp-route-id="@Model.MaYeuCau" class="btn btn-primary">Sửa đầu mục</a>
        <a asp-controller="ChiTietYeuCaus" asp-action="Create" asp-route-maYeuCau="@Model.MaYeuCau" class="btn btn-success">+ Thêm chi tiết</a>
        <a asp-action="Huy" asp-route-id="@Model.MaYeuCau" class="btn btn-outline-danger">Hủy yêu cầu</a>
    }
    @if (duocGuiDuyet)
    {
        <form asp-action="GuiDuyet" asp-route-id="@Model.MaYeuCau" method="post"
              onsubmit="return confirm('Gửi yêu cầu này đi duyệt?')">
            <button class="btn btn-warning">Gửi duyệt</button>
        </form>
    }
    @if (duocXetDuyet)
    {
        <a asp-action="Duyet" asp-route-id="@Model.MaYeuCau" class="btn btn-success">Xét duyệt</a>
        <a asp-action="TuChoi" asp-route-id="@Model.MaYeuCau" class="btn btn-danger">Từ chối</a>
    }
</div>

<h5>Chi tiết yêu cầu</h5>
<table class="table table-bordered">
    <thead class="table-light">
        <tr>
            <th>Hàng hóa</th><th>Đơn vị tính</th><th>SL yêu cầu</th><th>SL duyệt</th><th>Ghi chú</th>
            @if (duocSuaXoa) { <th></th> }
        </tr>
    </thead>
    <tbody>
    @foreach (var ct in Model.ChiTietYeuCaus)
    {
        <tr>
            <td>@ct.HangHoa.TenHang</td>
            <td>@ct.HangHoa.DonViTinh.TenDonViTinh</td>
            <td>@ct.SoLuongYeuCau</td>
            <td>@(Model.TrangThai == TrangThaiYeuCau.Nhap || Model.TrangThai == TrangThaiYeuCau.ChoDuyet ? "-" : ct.SoLuongDuyet.ToString())</td>
            <td>@ct.GhiChu</td>
            @if (duocSuaXoa)
            {
                <td class="d-flex gap-1">
                    <a asp-controller="ChiTietYeuCaus" asp-action="Edit" asp-route-id="@ct.MaChiTietYeuCau" class="btn btn-sm btn-primary">Sửa</a>
                    <form asp-controller="ChiTietYeuCaus" asp-action="Delete" asp-route-id="@ct.MaChiTietYeuCau" method="post"
                          onsubmit="return confirm('Xóa dòng này?')">
                        <button class="btn btn-sm btn-danger">Xóa</button>
                    </form>
                </td>
            }
        </tr>
    }
    @if (!Model.ChiTietYeuCaus.Any())
    {
        <tr><td colspan="6" class="text-center text-muted">Chưa có chi tiết nào</td></tr>
    }
    </tbody>
</table>
