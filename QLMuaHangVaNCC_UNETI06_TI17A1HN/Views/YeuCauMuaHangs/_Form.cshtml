@* Họ và tên: Hoàng Thùy Dương
   Mã sinh viên: 23103100051
   Nội dung thực hiện: Module 3 - Partial form dùng chung cho Create và Edit yêu cầu. *@
@using QLMuaHangVaNCC_UNETI06_TI17A1HN.Models
@using QLMuaHangVaNCC_UNETI06_TI17A1HN.ViewModels
@model YeuCauFormViewModel
@{
    var laSua = Model.MaYeuCau > 0;
}
<div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
<input type="hidden" asp-for="MaYeuCau" />

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="MaBoPhan" class="form-label"></label>
        <select asp-for="MaBoPhan" asp-items="Model.DanhSachBoPhan" class="form-select">
            <option value="">-- Chọn bộ phận --</option>
        </select>
        <span asp-validation-for="MaBoPhan" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="MucDoUuTien" class="form-label"></label>
        <select asp-for="MucDoUuTien" class="form-select">
            @foreach (var m in MucUuTien.TatCa)
            {
                <option value="@m" selected="@(Model.MucDoUuTien == m)">@MucUuTien.Nhan(m)</option>
            }
        </select>
        <span asp-validation-for="MucDoUuTien" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="NgayYeuCau" class="form-label"></label>
        @if (laSua)
        {
            @* Ngày yêu cầu không đổi khi sửa: hiển thị + gửi kèm bằng hidden để validation so sánh ngày *@
            <input asp-for="NgayYeuCau" type="date" class="form-control" readonly />
        }
        else
        {
            <input asp-for="NgayYeuCau" type="date" class="form-control" />
        }
        <span asp-validation-for="NgayYeuCau" class="text-danger"></span>
    </div>
    <div class="col-md-6">
        <label asp-for="NgayCanHang" class="form-label"></label>
        <input asp-for="NgayCanHang" type="date" class="form-control" />
        <span asp-validation-for="NgayCanHang" class="text-danger"></span>
    </div>
    <div class="col-12">
        <label asp-for="LyDoMua" class="form-label"></label>
        <textarea asp-for="LyDoMua" class="form-control" rows="3"></textarea>
        <span asp-validation-for="LyDoMua" class="text-danger"></span>
    </div>
</div>
