@model LyDoViewModel
@{ ViewData["Title"] = "Từ chối yêu cầu"; }

<h3>Từ chối yêu cầu #@Model.MaYeuCau</h3>
<form asp-action="TuChoi" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <input type="hidden" asp-for="MaYeuCau" />
    <div class="mb-3">
        <label asp-for="LyDo" class="form-label">Lý do từ chối</label>
        <textarea asp-for="LyDo" class="form-control" rows="3"></textarea>
        <span asp-validation-for="LyDo" class="text-danger"></span>
    </div>
    <button class="btn btn-danger">Xác nhận từ chối</button>
    <a asp-action="Details" asp-route-id="@Model.MaYeuCau" class="btn btn-secondary">Quay lại</a>
</form>

@section Scripts { <partial name="_ValidationScriptsPartial" /> }
