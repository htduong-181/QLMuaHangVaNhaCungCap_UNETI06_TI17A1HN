@model IEnumerable<QLMuaHangVaNCC_UNETI06_TI17A1HN.Models.ChiTietGiaoHang>

@{
    ViewData["Title"] = "Chi tiết giao hàng";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="mb-0">Chi tiết giao hàng</h1>
    <a asp-controller="LanGiaoHangs" asp-action="Create" class="btn btn-primary">Ghi nhận lần giao</a>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover table-striped align-middle text-center mb-0">
            <thead class="table-dark">
                <tr>
                    <th>Mã chi tiết giao</th>
                    <th>Mã lần giao</th>
                    <th>Mặt hàng</th>
                    <th>Số lượng nhận</th>
                    <th>Số lượng đạt chất lượng</th>
                    <th>Ghi chú</th>
                    <th>Trạng thái lần giao</th>
                    <th>Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.MaChiTietGiao</td>
                        <td>
                            <a asp-controller="LanGiaoHangs" asp-action="Details" asp-route-malangiao="@item.MaLanGiao">@item.MaLanGiao</a>
                        </td>
                        <td>@item.ChiTietDonMua?.HangHoa?.TenHang</td>
                        <td>@item.SoLuongNhan</td>
                        <td>@(item.SoLuongDatChatLuong?.ToString() ?? "-")</td>
                        <td>@item.GhiChu</td>
                        <td>
                            @if (item.LanGiaoHang != null && item.LanGiaoHang.TrangThai)
                            {
                                <span class="badge bg-success">Còn hiệu lực</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Vô hiệu</span>
                            }
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="Details" asp-route-id="@item.MaChiTietGiao" class="btn btn-sm btn-outline-info">Chi tiết</a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">Chưa có dữ liệu.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>